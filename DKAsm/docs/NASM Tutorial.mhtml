<p>Here=E2=80=99s a function that adds four floats at once:

</p><div class=3D"filename"><span>add_four_floats.asm</span></div><pre><cod=
e class=3D"language-x86asm hljs" data-highlighted=3D"yes"><span class=3D"hl=
js-comment">; void add_four_floats(float x[4], float y[4])</span>
<span class=3D"hljs-comment">; x[i] +=3D y[i] for i in range(0..4)</span>

        <span class=3D"hljs-meta">global</span>   add_four_floats
        <span class=3D"hljs-meta">section</span>  .text
<span class=3D"hljs-symbol">
add_four_floats:</span>
        <span class=3D"hljs-keyword">movdqa</span>   <span class=3D"hljs-bu=
ilt_in">xmm0</span>, [<span class=3D"hljs-built_in">rdi</span>]            =
<span class=3D"hljs-comment">; all four values of x</span>
        <span class=3D"hljs-keyword">movdqa</span>   <span class=3D"hljs-bu=
ilt_in">xmm1</span>, [<span class=3D"hljs-built_in">rsi</span>]            =
<span class=3D"hljs-comment">; all four values of y</span>
        <span class=3D"hljs-keyword">addps</span>    <span class=3D"hljs-bu=
ilt_in">xmm0</span>, <span class=3D"hljs-built_in">xmm1</span>             =
<span class=3D"hljs-comment">; do all four sums in one shot</span>
        <span class=3D"hljs-keyword">movdqa</span>   [<span class=3D"hljs-b=
uilt_in">rdi</span>], <span class=3D"hljs-built_in">xmm0</span>
        <span class=3D"hljs-keyword">ret</span>
</code></pre>
