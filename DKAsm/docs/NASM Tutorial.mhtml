maxlines  <span class=3D"hljs-built_in">equ</span>       <span class=3D"hlj=
s-number">8</span>
dataSize  <span class=3D"hljs-built_in">equ</span>       <span class=3D"hlj=
s-number">44</span>
<span class=3D"hljs-symbol">output:</span>   <span class=3D"hljs-built_in">=
resb</span>      dataSize
</code></pre>
<pre class=3D"console">$ <kbd>nasm -fmacho64 triangle.asm &amp;&amp; ld tri=
angle.o &amp;&amp; ./a.out</kbd>
*
**
***
****
*****
******
*******
