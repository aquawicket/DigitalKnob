umber.  This program uses a data</span>
<span class=3D"hljs-comment">; section to store intermediate results, not t=
hat it has to, but only to</span>
<span class=3D"hljs-comment">; illustrate how data sections are used.</span=
>
<span class=3D"hljs-comment">; --------------------------------------------=
---------------------------------</span>

        <span class=3D"hljs-meta">global</span>   main
        <span class=3D"hljs-meta">extern</span>   atoi
        <span class=3D"hljs-meta">extern</span>   printf
        <span class=3D"hljs-meta">default</span>  <span class=3D"hljs-built=
_in">rel</span>

        <span class=3D"hljs-meta">section</span>  .text
<span class=3D"hljs-symbol">main:</span>
        <span class=3D"hljs-keyword">dec</span>      <span class=3D"hljs-bu=
ilt_in">rdi</span>                    <span class=3D"hljs-comment">; argc-1=
, since we don't count program name</span>
        <span class=3D"hljs-keyword">jz</span>       nothingToAverage
        <span class=3D"hljs-keyword">mov</span>      [count], <span class=
=3D"hljs-built_in">rdi</span>           <span class=3D"hljs-comment">; save=
 number of real arguments</span>
<span class=3D"hljs-symbol">accumulate:</span>
        <span class=3D"hljs-keyword">push</span>     <span class=3D"hljs-bu=
ilt_in">rdi</span>                    <span class=3D"hljs-comment">; save r=
egister across call to atoi</span>
        <span class=3D"hljs-keyword">push</span>     <span class=3D"hljs-bu=
ilt_in">rsi</span>
        <span class=3D"hljs-keyword">mov</span>      <span class=3D"hljs-bu=
ilt_in">rdi</span>, [<span class=3D"hljs-built_in">rsi</span>+<span class=
=3D"hljs-built_in">rdi</span>*<span class=3D"hljs-number">8</span>]       <=
span class=3D"hljs-comment">; argv[rdi]</span>
        <span class=3D"hljs-keyword">call</span>     atoi                  =
 <span class=3D"hljs-comment">; now rax has the int value of arg</span>
        <span class=3D"hljs-keyword">pop</span>      <span class=3D"hljs-bu=
ilt_in">rsi</span>                    <span class=3D"hljs-comment">; restor=
e registers after atoi call</span>
        <span class=3D"hljs-keyword">pop</span>      <span class=3D"hljs-bu=
ilt_in">rdi</span>
        <span class=3D"hljs-keyword">add</span>      [sum], <span class=3D"=
hljs-built_in">rax</span>             <span class=3D"hljs-comment">; accumu=
late sum as we go</span>
        <span class=3D"hljs-keyword">dec</span>      <span class=3D"hljs-bu=
ilt_in">rdi</span>                    <span class=3D"hljs-comment">; count =
down</span>
        <span class=3D"hljs-keyword">jnz</span>      accumulate            =
 <span class=3D"hljs-comment">; more arguments?</span>
<span class=3D"hljs-symbol">average:</span>
