@charset "utf-8";

.prettyprint { background: rgb(0, 36, 81); font-family: Menlo, Monaco, Cons=
olas, monospace; border: 0px !important; }

.pln { color: rgb(255, 255, 255); }

ol.linenums { margin-top: 0px; margin-bottom: 0px; color: rgb(114, 133, 183=
); }

li.L0, li.L1, li.L2, li.L3, li.L4, li.L5, li.L6, li.L7, li.L8, li.L9 { padd=
ing-left: 1em; background-color: rgb(0, 36, 81); list-style-type: decimal; =
}

@media screen {
  .str { color: rgb(209, 241, 169); }
  .kwd { color: rgb(222, 156, 250); text-shadow: blue 1px 1px 1px; }
  .com { color: rgb(116, 208, 222); font-style: italic; font-weight: lighte=
r; }
  .typ { color: rgb(106, 170, 248); }
  .lit { color: rgb(223, 204, 60); }
  .pun { color: rgb(255, 149, 149); }
  .opn { color: rgb(255, 255, 255); }
  .clo { color: rgb(255, 255, 255); }
  .tag { color: rgb(255, 157, 164); }
  .atn { color: rgb(255, 197, 143); }
  .atv { color: rgb(153, 255, 255); }
  .dec { color: rgb(255, 197, 143); }
  .var { color: rgb(255, 157, 164); }
  .fun { color: rgb(187, 218, 255); }
}
