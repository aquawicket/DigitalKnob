<span class=3D"hljs-type">int</span> <span class=3D"hljs-title function_">m=
ain</span><span class=3D"hljs-params">()</span> {
    <span class=3D"hljs-type">float</span> x[] =3D {<span class=3D"hljs-num=
ber">-29.750</span>, <span class=3D"hljs-number">244.333</span>, <span clas=
s=3D"hljs-number">887.29</span>, <span class=3D"hljs-number">48.1E22</span>=
};
    <span class=3D"hljs-type">float</span> y[] =3D {<span class=3D"hljs-num=
ber">29.750</span>,  <span class=3D"hljs-number">199.333</span>, <span clas=
s=3D"hljs-number">-8.29</span>,  <span class=3D"hljs-number">22.1E23</span>=
};
    add_four_floats(x, y);
    <span class=3D"hljs-built_in">printf</span>(<span class=3D"hljs-string"=
>"%f\n%f\n%f\n%f\n"</span>, x[<span class=3D"hljs-number">0</span>], x[<spa=
n class=3D"hljs-number">1</span>], x[<span class=3D"hljs-number">2</span>],=
