ext<br>example:<br>&nbsp; &nbsp; &nbsp; &nbsp; mov &nbsp; &nbsp; qword [</s=
pan><span class=3D"kwd">rsp</span><span class=3D"pln">-16], 7<br>&nbsp; &nb=
sp; &nbsp; &nbsp; mov &nbsp; &nbsp; </span><span class=3D"kwd">rax</span><s=
pan class=3D"pln">, </span><span class=3D"kwd">rdi</span><span class=3D"pln=
