rem Get the offsets of the labels in this NotBatch.txt file
for /F "tokens=1,2 delims=:" %a in ('findstr /O "^:.*" ^< DKPolyglot') do (
	echo.bat %b = %a
	set "%b=%a"
)

dkcall :A
dkcall :B
dkcall :main
exit %errorlevel%

rem #######################
:B
	dkecho ### :B ###
	dkecho     :B body
	dkecho ### :B END ###
	dkecho
dkgoto :EOF

rem ########################
:main
	dkecho ### :main ###
	dkecho 0 = %0 = %0%
	dkecho 1 = %1 = %1%
	dkecho 2 = %2 = %2%
	dkecho * = %* = %*%

	rem >con attrib -r "DKPolyglot.bat"
	rem >con copy /Y "DKPolyglot" "DKPolyglot.bat"
	rem >con attrib +r "DKPolyglot.bat"
	rem	attrib -r "DKPolyglot.cmd" & copy /Y "DKPolyglot" "DKPolyglot.cmd" && attrib +r "DKPolyglot.cmd"
	rem	attrib -r "DKPolyglot.sh"  & copy /Y "DKPolyglot" "DKPolyglot.sh"  && attrib +r "DKPolyglot.sh"
	rem	attrib -r "DKPolyglot.ps1" & copy /Y "DKPolyglot" "DKPolyglot.ps1" && attrib +r "DKPolyglot.ps1"

	rem ### Print Batch Version Info ###
	if defined ComSpec (set DKSHELL_PATH=%ComSpec:\=/%)
	for %Z in ("%DKSHELL_PATH%") do (set "DKSHELL_NAME=%~nZ")
	for /f "tokens=2 delims=[]" %v in ('ver') do (set "DKSHELL_VERSION=%v")
	set "DKSHELL_VERSION=%DKSHELL_VERSION:Version =%"
	dkecho [42m [30m %DKSHELL_NAME% %DKSHELL_VERSION% [0m %DKSHELL_PATH%
	dkecho 
	
	rem ### Print all variables
	set CMDCMDLINE=%CMDCMDLINE%
	set __CD__=%__CD__%
	set CD=%CD%
	>con set
	dkecho
	
	rem ### Pause before exit
	dkecho ### :main END ###
	dkecho
dkgoto :EOF

:A
	dkecho ### :A ###
	dkecho     :A body
	dkecho ### :A END ###
	dkecho
dkgoto :EOF

rem ########################## Batch Script End ##########################
exit /b 0
dkgoto :EOF
type con >nul
BATCH_SCRIPT
