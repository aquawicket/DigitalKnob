#!/usr/bin/cmake -P
### This file is generated by DKCMake. Any Changes here, will be overwritten. ###
### DK.cmake ############################################################
cmake_minimum_required(VERSION 3.10)
if(NOT EXISTS "$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake")
    cmake_policy(SET CMP0009 NEW)
    file(GLOB_RECURSE DK.cmake "/DK.cmake")
    list(GET DK.cmake 0 DK.cmake)
    get_filename_component(DKCMAKE_FUNCTIONS_DIR "${DK.cmake}" DIRECTORY)
    set(ENV{DKCMAKE_FUNCTIONS_DIR_} "${DKCMAKE_FUNCTIONS_DIR}/")
endif()
include("$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake")
include_guard()
#########################################################################


### Load all cmake flags prior to calling PROJECT() ###
dk_load("${DKCMAKE_DIR}/DKVariables.cmake")
dk_load("${DKCMAKE_DIR}/DKBuildFlags.cmake")

### Target_App_Dir ###
dk_set(Target_App_Dir "${CMAKE_CURRENT_LIST_DIR}")
dk_assertPath(Target_App_Dir)
dk_debug("Target_App_Dir = ${Target_App_Dir}")

### Target_App ###
dk_basename("${Target_App_Dir}")
dk_set(Target_App "${dk_basename}")
dk_assertVar(Target_App)
dk_debug("Target_App = ${Target_App}")

### Target_Tuple ### 
dk_load(dk_Target_Tuple)
dk_validate(Target_Tuple "dk_Target_Tuple()")
dk_debug("Target_Tuple = ${Target_Tuple}")

### CURRENT_PLUGIN ###
dk_set(CURRENT_PLUGIN "${Target_App}")
dk_assertVar(CURRENT_PLUGIN)
dk_debug("CURRENT_PLUGIN = ${CURRENT_PLUGIN}")

### DKCPP_PLUGINS_DIR ###
dk_assertPath(DKCPP_PLUGINS_DIR)
dk_debug("DKCPP_PLUGINS_DIR = ${DKCPP_PLUGINS_DIR}")

message("############ Generating ${Target_App} ############")
project(${Target_App})

### Add Include directories ###
include_directories(${Target_App_Dir})
include_directories(${DKCPP_PLUGINS_DIR})
include_directories($ENV{DKINCLUDES_LIST})

### Add definitions ###
add_definitions($ENV{DKDEFINES_LIST})

### Add Link Directories ###
link_directories($ENV{DKLINKDIRS_LIST})

# ### Add Dependencies ###
# foreach(Plugin $ENV{dkdepend_list})
# 	if(EXISTS "${DKCPP_PLUGINS_DIR}/${Plugin}/CMakeLists.txt")
# 		add_dependencies(${Target_App} ${Plugin})
# 	endif()	
# endforeach()

# ## CURRENT_PLUGIN ###
# dk_basename("${CMAKE_CURRENT_LIST_DIR}")
# dk_set(CURRENT_PLUGIN "${dk_basename}")
# dk_set(${CURRENT_PLUGIN} 	${CMAKE_SOURCE_DIR})
# dk_debug("CURRENT_PLUGIN = ${CURRENT_PLUGIN}")

### Add Source Files to project ###
dk_copy("${DKCPP_PLUGINS_DIR}/_DKIMPORT/main.cpp" "${Target_App_Dir}/main.cpp")
dk_copy("${DKCPP_PLUGINS_DIR}/_DKIMPORT/assets.h" "${Target_App_Dir}/assets.h")
file(GLOB App_SRC
    "${Target_App_Dir}/*.h"
    "${Target_App_Dir}/*.hpp"
    "${Target_App_Dir}/*.c"
    "${Target_App_Dir}/*.cpp"
    "${Target_App_Dir}/*.manifest"
    "${Target_App_Dir}/*.rc"
)

### Add Windows Specific Source Files to project ###
if(Windows)
    file(GLOB Icon_SRC
        "${Target_App_Dir}/Windows/*.h"
        "${Target_App_Dir}/Windows/*.hpp"
        "${Target_App_Dir}/Windows/*.c"
        "${Target_App_Dir}/Windows/*.cpp"
        "${Target_App_Dir}/Windows/*.manifest"
        "${Target_App_Dir}/Windows/*.rc"
    )
    list(APPEND App_SRC ${Icon_SRC})
	
	if(EXISTS "${Target_App_Dir}/icon.ico")
		list(APPEND App_SRC  "${DKCPP_PLUGINS_DIR}/_DKIMPORT/Windows/icon.h")
		list(APPEND App_SRC  "${DKCPP_PLUGINS_DIR}/_DKIMPORT/Windows/icon.rc")
	endif()
	
	if(HAVE_DK)
		list(APPEND App_SRC  "${DKCPP_PLUGINS_DIR}/_DKIMPORT/Windows/assets.h")
		list(APPEND App_SRC  "${DKCPP_PLUGINS_DIR}/_DKIMPORT/Windows/assets.rc")
	endif()
endif()

### Exclude some files from project ###
list(FILTER App_SRC EXCLUDE REGEX "${Target_App_Dir}/assets/*")
list(FILTER App_SRC EXCLUDE REGEX "${Target_App_Dir}/${Target_Tuple}/*")

### Backup previous compiled executable ###
#if(BACKUP_APP_EXECUTABLES)
#	dk_backupExecutable()
#endif()	

### Create Executable Target ###
if(MSVC)
    add_executable(${Target_App} WIN32 ${App_SRC})
else()
    add_executable(${Target_App} ${App_SRC})
endif()

### Link Libraries ###
dk_Target_Config()
if(MULTI_CONFIG)
    target_link_libraries(${Target_App} $ENV{DEBUG_LIBS} $ENV{RELEASE_LIBS} $ENV{LIBS})
else()
	if(Debug)
		target_link_libraries(${Target_App} $ENV{DEBUG_LIBS} $ENV{LIBS})
	elseif(Release)
		target_link_libraries(${Target_App} $ENV{RELEASE_LIBS} $ENV{LIBS})
	endif()
endif()




### Emscripten ###
if(Emscripten)
	set(CMAKE_EXECUTABLE_SUFFIX ".html")
	
	### Remove previous built files from assets ###
	dk_delete("${Target_App_Dir}/assets/${Target_App}.data"	NO_HALT)
	dk_delete("${Target_App_Dir}/assets/${Target_App}.html"	NO_HALT)
	dk_delete("${Target_App_Dir}/assets/${Target_App}.js"	NO_HALT)
	dk_delete("${Target_App_Dir}/assets/${Target_App}.wasm"	NO_HALT)

	### PACKAGE ASSETS ###
	if(EXISTS ${Target_App_Dir}/assets)
		set_target_properties(${Target_App} PROPERTIES LINK_FLAGS "-sASSERTIONS -sALLOW_MEMORY_GROWTH --preload-file ${Target_App_Dir}/assets@/")
	endif()
	
	### Create Run script ###
	dk_info("Creating Run scripts . . .")
	if(Debug)
		if(Windows_Host)
			set(RUN_SCRIPT_DEBUG
				"${emsdk_ENV} & ${emsdk}/upstream/emscripten/emrun.bat ${Target_App_Dir}/${Target_Tuple}/${Debug_Dir}/${Target_App}.html"
			)
			dk_fileWrite("${Target_App_Dir}/${Target_Tuple}/${Debug_Dir}/Run.bat" "${RUN_SCRIPT_DEBUG}")
		else()
			set(RUN_SCRIPT_DEBUG
				"\#!/bin/bash\n${emsdk_ENV} & ${emsdk}/upstream/emscripten/emrun ${Target_App_Dir}/${Target_Tuple}/${Debug_Dir}/${Target_App}.html"
			)
			dk_fileWrite("${Target_App_Dir}/${Target_Tuple}/${Debug_Dir}/Run.sh" "${RUN_SCRIPT_DEBUG}")
			dk_exec(chmod 777 "${Target_App_Dir}/${Target_Tuple}/${Debug_Dir}/Run.sh")
		endif()
	endif()
	if(Release)
		if(Windows_Host)
			set(RUN_SCRIPT_RELEASE
				"${emsdk_ENV} & ${emsdk}/upstream/emscripten/emrun.bat ${Target_App_Dir}/${Target_Tuple}/${Release_Dir}/${Target_App}.html"
			)
			dk_fileWrite("${Target_App_Dir}/${Target_Tuple}/${Release_Dir}/Run.bat" "${RUN_SCRIPT_RELEASE}")
		else()
			set(RUN_SCRIPT_RELEASE
				"\#!/bin/bash\n"
				"${emsdk_ENV} & ${emsdk}/upstream/emscripten/emrun ${Target_App_Dir}/${Target_Tuple}/${Release_Dir}/${Target_App}.html"
			)
			dk_fileWrite("${Target_App_Dir}/${Target_Tuple}/${Release_Dir}/Run.sh" "${RUN_SCRIPT_RELEASE}")
			dk_exec(chmod 777 "${Target_App_Dir}/${Target_Tuple}/${Release_Dir}/Run.sh")
		endif()
	endif()
endif()

### MSVC ###
if(MSVC)
#	dk_replaceAll("${DEBUG_LINK_FLAGS}"  ";"  " "  DEBUG_FLAGS)
#	dk_replaceAll("${RELEASE_LINK_FLAGS}"  ";"  " "  RELEASE_FLAGS)
#	set_target_properties(${Target_App} PROPERTIES LINK_FLAGS_DEBUG ${DEBUG_FLAGS} LINK_FLAGS_RELEASE ${RELEASE_FLAGS})
	set_property(DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY VS_STARTUP_PROJECT ${Target_App})
endif()
