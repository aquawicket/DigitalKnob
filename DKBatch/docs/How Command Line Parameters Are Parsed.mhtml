</td><td>&nbsp;</td><td>&nbsp;</td></tr>
      <tr><td><span class=3D"code">CreateProcess(cmdline)&nbsp;&nbsp;</span=
><span class=3D"darrow">=E2=86=92</span></td><td class=3D"rbdr">&nbsp;</td>=
<td>&nbsp;</td>
          <td><span class=3D"darrow">=E2=86=92</span></td><td><span class=
