@echo off
::########################## Batch Script Begin ##########################

::### Print Batch Version Info ###
if defined ComSpec (set "DKSHELL_PATH=%ComSpec:\=/%")
for %%Z in ("%DKSHELL_PATH%") do (set "DKSHELL_NAME=%%~nZ")
for /f "tokens=2 delims=[]" %%v in ('ver') do (set "DKSHELL_VERSION=%%v")
set "DKSHELL_VERSION=%DKSHELL_VERSION:Version =%"
set "ESC="
echo %ESC%[42m %ESC%[30m %DKSHELL_NAME% %DKSHELL_VERSION% %ESC%[0m %DKSHELL_PATH%

echo:
set "DKSCRIPT_PATH=%~0"
set "DKSCRIPT_ARGS=%*"
echo DKSCRIPT_PATH = %DKSCRIPT_PATH%
echo DKSCRIPT_ARGS = %DKSCRIPT_ARGS%
echo:

pause

::########################## Batch Script End ##########################
exit /b 0
goto: eof
type con >nul
BATCH_SCRIPT
