set +o histexpand 2>/dev/null
########################## Bash Script Begin ##########################

### Print Bash Version Info ###
export ESC=""  # escape character
[ -n "${BASH-}" ] && export DKSHELL_PATH=${BASH-} || export DKSHELL_PATH=${SHELL-}
export DKSHELL=$(basename ${DKSHELL_PATH})
export DKSHELL_VERSION="$($DKSHELL_PATH --help 2>&1 | head -1)"
echo "${ESC}[45m ${ESC}[30m ${DKSHELL} Version ${DKSHELL_VERSION} ${ESC}[0m ${DKSHELL_PATH}"

echo ""
DKSCRIPT_PATH=$0
DKSCRIPT_ARGS=$*
echo "DKSCRIPT_PATH = ${DKSCRIPT_PATH}"
echo "DKSCRIPT_ARGS = ${DKSCRIPT_ARGS}"
echo ""

read -rp ''

########################## Bash Script End ##########################
case $- in *"i"*) cat /dev/stdin >/dev/null ;; esac
exit
