rem # waybackMachine/dk_saveUrl(url)
rem #
:dk_saveUrl
%setlocal%
	
	rem ##### Save the url to Wayback Machine ######
	%dk_call% curl.exe https://web.archive.org/save/%~1

%endfunction%




