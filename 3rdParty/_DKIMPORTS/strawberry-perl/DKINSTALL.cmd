:DKINSTALL
%setlocal%
	
	%dk_call% dk_import
	
	set "perl_exe=%PLUGIN_Install_Path%/perl/bin/perl.exe"
	%dk_call% dk_assertPath "%perl_exe%"
%endfunction%
