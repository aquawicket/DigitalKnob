LINUX_dk_libRelease(${OSGAUDIO_RELEASE_DIR}/lib/libosgAudio.a)
RASPBERRY_dk_libDebug(${OSGAUDIO_DEBUG_DIR}/lib/libosgAudiod.a)
RASPBERRY_dk_libRelease(${OSGAUDIO_RELEASE_DIR}/lib/libosgAudio.a)
