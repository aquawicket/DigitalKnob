function(DKINSTALL)
    dk_debugFunc()

    dk_import()
endfunction()





###### DKTEST ###### DKTEST ###### DKTEST ###### DKTEST ###### DKTEST ######
function(DKTEST)
	dk_debugFunc(0)

	DKINSTALL()
endfunction()

