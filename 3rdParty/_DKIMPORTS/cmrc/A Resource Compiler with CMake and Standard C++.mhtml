    <span class=3D"c1"># Format each pair into a character literal</span>
    <span class=3D"nb">string</span><span class=3D"p">(</span>REGEX REPLACE=
 <span class=3D"s2">"(..)"</span> <span class=3D"s2">"'</span><span class=
=3D"se">\\\\</span><span class=3D"s2">x</span><span class=3D"se">\\</span><=
span class=3D"s2">1', "</span> chars <span class=3D"s2">"</span><span class=
=3D"si">${</span><span class=3D"nv">bytes</span><span class=3D"si">}</span>=
<span class=3D"s2">"</span><span class=3D"p">)</span>
    <span class=3D"nb">file</span><span class=3D"p">(</span>WRITE <span cla=
ss=3D"s2">"</span><span class=3D"si">${</span><span class=3D"nv">OUTPUT_FIL=
E</span><span class=3D"si">}</span><span class=3D"s2">"</span> <span class=
=3D"s2">"
namespace { const char file_array[] =3D { </span><span class=3D"si">${</spa=
n><span class=3D"nv">chars</span><span class=3D"si">}</span><span class=3D"=
s2"> }; }
