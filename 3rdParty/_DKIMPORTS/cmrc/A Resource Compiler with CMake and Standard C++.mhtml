    return open(fname.data());
}

}

#endif // CMRC_CMRC_HPP_INCLUDED
]=3D=3D]</span><span class=3D"p">)</span>

<span class=3D"nb">add_library</span><span class=3D"p">(</span>cmrc-base IN=
TERFACE<span class=3D"p">)</span>
<span class=3D"nb">target_include_directories</span><span class=3D"p">(</sp=
an>cmrc-base INTERFACE <span class=3D"s2">"</span><span class=3D"si">${</sp=
an><span class=3D"nv">CMRC_INCLUDE_DIR</span><span class=3D"si">}</span><sp=
an class=3D"s2">"</span><span class=3D"p">)</span>
<span class=3D"nb">target_compile_features</span><span class=3D"p">(</span>=
cmrc-base INTERFACE cxx_nullptr<span class=3D"p">)</span>
<span class=3D"nb">set_property</span><span class=3D"p">(</span>TARGET cmrc=
-base PROPERTY INTERFACE_CXX_EXTENSIONS OFF<span class=3D"p">)</span>
<span class=3D"nb">add_library</span><span class=3D"p">(</span>cmrc::base A=
LIAS cmrc-base<span class=3D"p">)</span>
</code></pre></div></div>

<p>Now, as soon as <code class=3D"language-plaintext highlighter-rouge">CMa=
keRC.cmake</code> is included, there will be a target <code class=3D"langua=
ge-plaintext highlighter-rouge">cmrc::base</code>
that can be linked to so that anyone can get the proper include directories=
. We
can propagate that further by modifying <code class=3D"language-plaintext h=
ighlighter-rouge">cmrc_add_resource_library</code>:</p>

<div class=3D"language-cmake highlighter-rouge"><div class=3D"highlight"><p=
re class=3D"highlight"><code><span class=3D"nb">function</span><span class=
=3D"p">(</span>cmrc_add_resource_library name<span class=3D"p">)</span>
    <span class=3D"nb">add_library</span><span class=3D"p">(</span><span cl=
ass=3D"si">${</span><span class=3D"nv">name</span><span class=3D"si">}</spa=
n> INTERFACE<span class=3D"p">)</span>
    <span class=3D"nb">target_link_libraries</span><span class=3D"p">(</spa=
n><span class=3D"si">${</span><span class=3D"nv">name</span><span class=3D"=
si">}</span> INTERFACE cmrc::base<span class=3D"p">)</span>
<span class=3D"nb">endfunction</span><span class=3D"p">()</span>
</code></pre></div></div>

<p>Now anyone who links to a resource library will also link to <code class=
=3D"language-plaintext highlighter-rouge">cmrc::base</code>, and
will be able to include <code class=3D"language-plaintext highlighter-rouge=
">cmrc/cmrc.hpp</code>. They=E2=80=99ll also get the required compiler
flags for <code class=3D"language-plaintext highlighter-rouge">nullptr</cod=
e> to be available when they compile. Great!</p>

<p>Of course, the test case doesn=E2=80=99t yet pass. We=E2=80=99ve got a f=
ew things to do before
we can get there=E2=80=A6</p>

<h2 id=3D"step-3-compiling-a-resource">Step 3: Compiling a Resource</h2>

<p>Now, how does one actually <em>compile an arbitrary file</em>? Well, it=
=E2=80=99s not actually
hard <em>in theory</em>. What we need is to convert the file to a sequence =
of
character literals that we will put into a <code class=3D"language-plaintex=
t highlighter-rouge">char[]</code> array that can then be read
by the program at runtime.</p>

<p>So, how do we do that?</p>

<p>Well, we need to generate a source file that can be read by the compiler=
. CMake
has great support for this via <code class=3D"language-plaintext highlighte=
r-rouge">add_custom_command</code>! Let=E2=80=99s define a function,
called <code class=3D"language-plaintext highlighter-rouge">_cmrc_generate_=
intermediate_cpp</code>, which will generate an intermediate
C++ file containing such a character array:</p>

<div class=3D"language-cmake highlighter-rouge"><div class=3D"highlight"><p=
re class=3D"highlight"><code><span class=3D"nb">function</span><span class=
=3D"p">(</span>_cmrc_generate_intermediate_cpp outfile infile<span class=3D=
"p">)</span>
    <span class=3D"nb">add_custom_command</span><span class=3D"p">(</span>
        <span class=3D"c1"># This is the file we will generate</span>
        OUTPUT <span class=3D"s2">"</span><span class=3D"si">${</span><span=
 class=3D"nv">outfile</span><span class=3D"si">}</span><span class=3D"s2">"=
</span>
        <span class=3D"c1"># These are the primary files that affect the ou=
tput</span>
        DEPENDS <span class=3D"s2">"</span><span class=3D"si">${</span><spa=
n class=3D"nv">infile</span><span class=3D"si">}</span><span class=3D"s2">"=
</span> <span class=3D"s2">"</span><span class=3D"si">${</span><span class=
=3D"nv">this_script</span><span class=3D"si">}</span><span class=3D"s2">"</=
span>
        COMMAND
            <span class=3D"s2">"</span><span class=3D"si">${</span><span cl=
ass=3D"nv">CMAKE_COMMAND</span><span class=3D"si">}</span><span class=3D"s2=
">"</span>
                -D_CMRC_GENERATE_MODE=3DTRUE
                <span class=3D"s2">"-DINPUT_FILE=3D</span><span class=3D"si=
">${</span><span class=3D"nv">infile</span><span class=3D"si">}</span><span=
 class=3D"s2">"</span>
                <span class=3D"s2">"-DOUTPUT_FILE=3D</span><span class=3D"s=
i">${</span><span class=3D"nv">outfile</span><span class=3D"si">}</span><sp=
an class=3D"s2">"</span>
                -P <span class=3D"s2">"</span><span class=3D"si">${</span><=
span class=3D"nv">this_script</span><span class=3D"si">}</span><span class=
=3D"s2">"</span>
        COMMENT <span class=3D"s2">"Generating intermediate file for </span=
><span class=3D"si">${</span><span class=3D"nv">infile</span><span class=3D=
"si">}</span><span class=3D"s2">"</span>
    <span class=3D"p">)</span>
<span class=3D"nb">endfunction</span><span class=3D"p">()</span>
</code></pre></div></div>

<p>Well=E2=80=A6 It doesn=E2=80=99t actually generate the array. It adds a =
build command which
will generate the file <em>at build time</em>. We <em>do not</em> want to g=
enerate the
intermediate file immediately: It may be costly (the input file may be very
large), or the input file may be the output of a previous build command. Th=
is
also allows us to make use of any inherent parallelism afforded us by a bui=
ld
tool like Make or Ninja. We invoke the <code class=3D"language-plaintext hi=
ghlighter-rouge">CMakeRC.cmake</code> script as the build
command using <code class=3D"language-plaintext highlighter-rouge">cmake -P=
</code>, which is quite a useful trick for building more
complex commands. We pass in three primary arguments: the input file, the o=
utput
file, and a boolean <code class=3D"language-plaintext highlighter-rouge">_C=
MRC_GENERATE_MODE</code>. I=E2=80=99ll get back to that one later.</p>

<p>So, how do we use <code class=3D"language-plaintext highlighter-rouge">_=
cmrc_generate_intermediate_cpp</code>?
We modify <code class=3D"language-plaintext highlighter-rouge">cmrc_add_res=
ource_library</code> to call <code class=3D"language-plaintext highlighter-=
rouge">_cmrc_generate_intermediate_cpp</code>
for each resource file pass in, like so:</p>

<div class=3D"language-cmake highlighter-rouge"><div class=3D"highlight"><p=
re class=3D"highlight"><code><span class=3D"nb">function</span><span class=
=3D"p">(</span>cmrc_add_resource_library name<span class=3D"p">)</span>
    <span class=3D"c1"># Generate a static library with the compiled in cha=
racter arrays.</span>
    <span class=3D"nb">set</span><span class=3D"p">(</span>sources<span cla=
ss=3D"p">)</span>
    <span class=3D"nb">foreach</span><span class=3D"p">(</span>input IN LIS=
TS ARGN<span class=3D"p">)</span>
        <span class=3D"nb">get_filename_component</span><span class=3D"p">(=
</span>abs_input <span class=3D"s2">"</span><span class=3D"si">${</span><sp=
an class=3D"nv">input</span><span class=3D"si">}</span><span class=3D"s2">"=
</span> ABSOLUTE<span class=3D"p">)</span>
        <span class=3D"c1"># Generate a filename based on the input filenam=
e that we can put in</span>
        <span class=3D"c1"># the intermediate directory.</span>
        <span class=3D"nb">file</span><span class=3D"p">(</span>RELATIVE_PA=
TH relpath <span class=3D"s2">"</span><span class=3D"si">${</span><span cla=
ss=3D"nv">CMAKE_CURRENT_SOURCE_DIR</span><span class=3D"si">}</span><span c=
lass=3D"s2">"</span> <span class=3D"s2">"</span><span class=3D"si">${</span=
><span class=3D"nv">abs_input</span><span class=3D"si">}</span><span class=
=3D"s2">"</span><span class=3D"p">)</span>
        <span class=3D"nb">if</span><span class=3D"p">(</span>relpath MATCH=
ES <span class=3D"s2">"^</span><span class=3D"se">\\</span><span class=3D"s=
2">.</span><span class=3D"se">\\</span><span class=3D"s2">."</span><span cl=
ass=3D"p">)</span>
            <span class=3D"c1"># For now we just error on files that exist =
outside of the soure dir.</span>
            <span class=3D"nb">message</span><span class=3D"p">(</span>SEND=
_ERROR <span class=3D"s2">"Cannot add file '</span><span class=3D"si">${</s=
pan><span class=3D"nv">input</span><span class=3D"si">}</span><span class=
=3D"s2">': File must be in a subdirectory of the source directory"</span><s=
pan class=3D"p">)</span>
