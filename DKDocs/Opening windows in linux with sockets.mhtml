    *((u16 *)&amp;SendBuffer[8]) =3D FontNameLength;
    strncpy(SendBuffer + 12, (char *)FontName, FontNameLength);

    i32 WriteSize =3D 12 + FontNameLength + Pad;
    BytesWritten =3D write(Socket, (char *)&amp;SendBuffer, WriteSize);
}
