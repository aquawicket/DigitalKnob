<pre tabindex=3D"0"><code>void X_OpenFont(i32 Socket, i8 *FontName, i32 Fon=
tId) {
    char SendBuffer[16*1024] =3D {};
    int BytesWritten =3D 0;
    int BytesRead =3D 0;

    i32 FontNameLength =3D strlen((char *)FontName);
    i32 Pad =3D PAD(FontNameLength);
