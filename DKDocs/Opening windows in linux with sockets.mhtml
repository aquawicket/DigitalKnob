    *((int32_t *)&amp;SendBuffer[20]) =3D 0xFF000000; // Background
    *((int32_t *)&amp;SendBuffer[24]) =3D FontId; // Font

    write(Socket, (char *)&amp;SendBuffer, RequestLength*4);
}

