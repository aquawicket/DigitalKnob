    *((int32_t *)&amp;SendBuffer[24]) =3D GlobalRootVisualId;
    *((int32_t *)&amp;SendBuffer[28]) =3D X11_FLAG_WIN_EVENT | X11_FLAG_BAC=
KGROUND_PIXEL;
