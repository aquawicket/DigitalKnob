              <h4>
                <a id=3D"idm140470522264080" name=3D"idm140470522264080"></=
a>Highlight Dependencies
              </h4>
              <h5>
                <a id=3D"idm140470522263392" name=3D"idm140470522263392"></=
a>Required
              </h5>
              <p class=3D"required">
                <a class=3D"xref" href=3D"https://www.linuxfromscratch.org/=
blfs/downloads/stable/BLFS-BOOK-12.2-sysv-nochunks.html#boost" title=3D"boo=
st-1.86.0">Boost-1.86.0</a> and <a class=3D"xref" href=3D"https://www.linux=
fromscratch.org/blfs/downloads/stable/BLFS-BOOK-12.2-sysv-nochunks.html#lua=
" title=3D"Lua-5.4.7">Lua-5.4.7</a>
              </p>
