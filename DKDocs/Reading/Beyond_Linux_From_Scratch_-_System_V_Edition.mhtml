td.h/a#include &lt;sys/types.h&gt;"    fscklog/extract.c &amp;&amp;
sed -i "/ioctl.h/a#include &lt;sys/sysmacros.h&gt;" libfs/devices.c   &amp;=
&amp;

./configure &amp;&amp;
make</kbd></pre>
