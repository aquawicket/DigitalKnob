              <div class=3D"variablelist">
                <h4>
                  <a id=3D"idm140470475999280" name=3D"idm140470475999280">=
</a>Short Descriptions
                </h4>
                <table border=3D"0" class=3D"variablelist">
                  <colgroup>
                    <col align=3D"left" valign=3D"top">
                    <col>
                  </colgroup>
                  <tbody>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"fop-prog" name=3D"fop-prog"></a><span cl=
ass=3D"term"><span class=3D"command"><strong>fop</strong></span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          is a wrapper script to the <span class=3D"command=
"><strong>java</strong></span> command
                          which sets up the <span class=3D"application">fop=
</span> environment and passes the
                          required parameters
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"fop.jar" name=3D"fop.jar"></a><span clas=
s=3D"term"><code class=3D"filename">fop.jar</code></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          contains all the <span class=3D"application">fop<=
/span> <span class=3D"application">Java</span> classes
                        </p>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class=3D"titlepage">
            <div>
              <div>
                <h2 class=3D"title">
                  <a id=3D"mupdf" name=3D"mupdf"></a>MuPDF-1.24.8
                </h2>
              </div>
            </div>
          </div>
          <div class=3D"sect1" lang=3D"en" xml:lang=3D"en">
            <div class=3D"package" lang=3D"en" xml:lang=3D"en">
