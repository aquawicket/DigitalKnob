5.1">ICU-75.1</a>
              </p>
              <h5>
                <a id=3D"idm140470526920496" name=3D"idm140470526920496"></=
a>Optional
              </h5>
              <p class=3D"optional">
                <a class=3D"xref" href=3D"https://www.linuxfromscratch.org/=
blfs/downloads/stable/BLFS-BOOK-12.2-sysv-nochunks.html#valgrind" title=3D"=
Valgrind-3.23.0">Valgrind-3.23.0</a> (may be used in the
                tests)
              </p>
            </div>
            <div class=3D"installation" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Installation of libxml2
              </h3>
              <p>
                At first, fix an issue causing <span class=3D"command"><str=
ong>xmlcatalog</strong></span> to emit bogus
                warnings when a new catalog file is created. The patch will
                modify the building system, so regenerate the building
                scripts after applying the patch:
              </p>
              <pre class=3D"userinput"><kbd class=3D"command">patch -Np1 -i=
 ../libxml2-2.13.3-upstream_fix-2.patch</kbd></pre>
              <p>
                Install <span class=3D"application">libxml2</span> by runni=
ng
                the following commands:
              </p>
              <pre class=3D"userinput"><kbd class=3D"command">./configure -=
-prefix=3D/usr           \
            --sysconfdir=3D/etc       \
            --disable-static        \
            --with-history          \
            --with-icu              \
            PYTHON=3D/usr/bin/python3 \
            --docdir=3D/usr/share/doc/libxml2-2.13.3 &amp;&amp;
make</kbd></pre>
              <p>
                If you downloaded the test suite, issue the following
                command:
              </p>
              <pre class=3D"userinput"><kbd class=3D"command">tar xf ../xml=
ts20130923.tar.gz</kbd></pre>
              <p>
                To test the results, issue: <span class=3D"command"><strong=
>make check &gt; check.log</strong></span>.
                This command will print several lines of error messages lik=
e
                <span class=3D"quote">=E2=80=9C<span class=3D"quote"><code =
class=3D"computeroutput">Failed to parse
                xstc/...</code></span>=E2=80=9D</span> because some test fi=
les are
                missing and these messages can be safely ignored. A summary
                of the results can be obtained with <span class=3D"command"=
><strong>grep -E '^Total|expected|Ran'
                check.log</strong></span>. If <a class=3D"xref" href=3D"htt=
ps://www.linuxfromscratch.org/blfs/downloads/stable/BLFS-BOOK-12.2-sysv-noc=
hunks.html#valgrind" title=3D"Valgrind-3.23.0">Valgrind-3.23.0</a> is
                installed and you want to check for memory leaks, replace
                <span class=3D"command"><strong>check</strong></span> with
                <span class=3D"command"><strong>check-valgrind</strong></sp=
an>.
              </p>
              <div class=3D"admon note">
                <h3>
                  Note
                </h3>
                <p>
                  The tests use <a class=3D"ulink" href=3D"http://localhost=
/">http://localhost/</a> to test parsing
                  of external entities. If the machine where you run the
                  tests serves as a web site, the tests may hang, depending
                  on the content of the file served. It is therefore
                  recommended to shut down the server during the tests, as
                  the <code class=3D"systemitem">root</code> user:
                </p>
                <pre class=3D"userinput"><kbd class=3D"command">/etc/init.d=
/httpd stop</kbd></pre>
              </div>
              <p>
                Now, as the <code class=3D"systemitem">root</code> user:
              </p>
              <pre class=3D"root"><kbd class=3D"command">make install</kbd>=
</pre>
              <p>
                Finally, prevent some packages from unnecessarily linking t=
o
                ICU using the following commands as the <code class=3D"syst=
emitem">root</code> user:
              </p>
              <pre class=3D"root"><kbd class=3D"command">rm -vf /usr/lib/li=
bxml2.la &amp;&amp;
sed '/libs=3D/s/xml2.*/xml2"/' -i /usr/bin/xml2-config</kbd></pre>
            </div>
            <div class=3D"commands" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Command Explanations
              </h3>
              <p>
                <em class=3D"parameter"><code>--disable-static</code></em>:
                This switch prevents installation of static versions of the
                libraries.
              </p>
              <p>
                <em class=3D"parameter"><code>--with-history</code></em>: T=
his
                switch enables <span class=3D"application">Readline</span>
                support when running <span class=3D"command"><strong>xmlcat=
alog</strong></span> or <span class=3D"command"><strong>xmllint</strong></s=
pan> in shell mode.
              </p>
              <p>
                <em class=3D"parameter"><code>--with-icu</code></em>: This
                switch enables support for <span class=3D"application">ICU<=
/span>, which provides additional Unicode
                support. This is needed for some packages in BLFS, such as
                for QtWebEngine.
              </p>
              <p>
                <em class=3D"parameter"><code>PYTHON=3D/usr/bin/python3</co=
de></em>: Allows
                building the libxml2 module with Python3 instead of Python2=
.
              </p>
            </div>
