amp;&amp;
cd    build &amp;&amp;

meson setup ..            \
      --prefix=3D/usr       \
      --buildtype=3Drelease \
      -D others=3Denabled   \
      --wrap-mode=3Dnofallback &amp;&amp;
ninja</kbd></pre>
