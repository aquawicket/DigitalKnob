                    <tr>
                      <td>
                        <p>
                          <a id=3D"audacious-prog" name=3D"audacious-prog">=
</a><span class=3D"term"><span class=3D"command"><strong>audacious</strong>=
</span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          is an audio player and is a descendant of
                          <span class=3D"application">XMMS</span>
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"audtool" name=3D"audtool"></a><span clas=
