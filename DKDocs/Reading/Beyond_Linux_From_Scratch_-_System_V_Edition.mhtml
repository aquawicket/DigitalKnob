                    <tr>
                      <td>
                        <p>
                          <a id=3D"efivar-prog" name=3D"efivar-prog"></a><s=
pan class=3D"term"><span class=3D"command"><strong>efivar</strong></span></=
span>
                        </p>
                      </td>
                      <td>
                        <p>
