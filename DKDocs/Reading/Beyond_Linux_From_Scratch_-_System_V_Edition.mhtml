            <div class=3D"installation" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Installation of MuPDF
              </h3>
              <p>
                Install <span class=3D"application">MuPDF</span> by running=
 the
                following commands:
              </p>
              <pre class=3D"userinput"><kbd class=3D"command">cat &gt; user=
.make &lt;&lt; EOF &amp;&amp;
USE_SYSTEM_FREETYPE :=3D yes
USE_SYSTEM_HARFBUZZ :=3D yes
USE_SYSTEM_JBIG2DEC :=3D no
USE_SYSTEM_JPEGXR :=3D no # not used without HAVE_JPEGXR
USE_SYSTEM_LCMS2 :=3D no # need lcms2-art fork
USE_SYSTEM_LIBJPEG :=3D yes
USE_SYSTEM_MUJS :=3D no # build needs source anyway
USE_SYSTEM_OPENJPEG :=3D yes
USE_SYSTEM_ZLIB :=3D yes
USE_SYSTEM_GLUT :=3D no # need freeglut2-art fork
USE_SYSTEM_CURL :=3D yes
USE_SYSTEM_GUMBO :=3D no
EOF

export XCFLAGS=3D-fPIC                      &amp;&amp;
make build=3Drelease shared=3Dyes verbose=3Dyes &amp;&amp;
unset XCFLAGS</kbd></pre>
              <p>
                This package does not come with a test suite.
              </p>
              <p>
                Now, as the <code class=3D"systemitem">root</code> user:
              </p>
              <pre class=3D"root"><kbd class=3D"command">make prefix=3D/usr=
                        \
     shared=3Dyes                         \
     docdir=3D/usr/share/doc/mupdf-1.24.8 \
     install                            &amp;&amp;

ln -sfv libmupdf.so.24.8 /usr/lib/libmupdf.so   &amp;&amp;
ln -sfv libmupdf.so.24.8 /usr/lib/libmupdf.so.8 &amp;&amp;
chmod 755 /usr/lib/libmupdf.so.24.8             &amp;&amp;

ln -sfv mupdf-x11 /usr/bin/mupdf</kbd></pre>
