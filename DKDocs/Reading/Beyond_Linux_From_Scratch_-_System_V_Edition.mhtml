ng>
                    <span class=3D"segbody">None</span>
                  </div>
                </div>
              </div>
              <div class=3D"variablelist">
                <h4>
                  <a id=3D"idm140470503643920" name=3D"idm140470503643920">=
</a>Short Descriptions
                </h4>
                <table border=3D"0" class=3D"variablelist">
                  <colgroup>
                    <col align=3D"left" valign=3D"top">
                    <col>
                  </colgroup>
                  <tbody>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"fetchmail-prog" name=3D"fetchmail-prog">=
</a><span class=3D"term"><span class=3D"command"><strong>fetchmail</strong>=
</span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          when executed as a user, this will source
                          <code class=3D"filename">~/.fetchmailrc</code> an=
d
                          download the appropriate mail
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"fetchmailconf" name=3D"fetchmailconf"></=
a><span class=3D"term"><span class=3D"command"><strong>fetchmailconf</stron=
g></span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          is intended to assist you in setting up and editi=
ng
                          a <code class=3D"filename">~/.fetchmailrc</code>
                          configuration file, by using a <span class=3D"app=
lication">Tk</span> GUI interface. It is
                          written for <span class=3D"application">Python</s=
pan>
                          and the Tkinter module but is labelled with a
                          WARNING that it needs to be updated for fetchmail
                          6.4's SSL options and other recent new options
                        </p>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
          <div class=3D"titlepage">
            <div>
              <div>
                <h2 class=3D"title">
                  <a id=3D"mailx" name=3D"mailx"></a>mailx-12.5
                </h2>
              </div>
            </div>
          </div>
          <div class=3D"sect1" lang=3D"en" xml:lang=3D"en">
            <div class=3D"package" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Introduction to Heirloom mailx
              </h3>
              <p>
                The <span class=3D"application">Heirloom mailx</span> packa=
ge
                (formerly known as the <span class=3D"application">Nail</sp=
an>
                package) contains <span class=3D"command"><strong>mailx</st=
rong></span>, a command-line Mail
                User Agent derived from Berkeley Mail. It is intended to
                provide the functionality of the POSIX <span class=3D"comma=
nd"><strong>mailx</strong></span> command with
                additional support for MIME messages, IMAP (including
                caching), POP3, SMTP, S/MIME, message threading/sorting,
                scoring, and filtering. <span class=3D"application">Heirloo=
m
                mailx</span> is especially useful for writing scripts and
                batch processing.
              </p>
              <p>
                This package is known to build and work properly using an L=
FS
                12.2 platform.
              </p>
              <h4>
                <a id=3D"idm140470503619968" name=3D"idm140470503619968"></=
a>Package Information
              </h4>
              <div class=3D"itemizedlist">
                <ul class=3D"compact">
                  <li class=3D"listitem">
                    <p>
                      Download (HTTP): <a class=3D"ulink" href=3D"https://a=
nduin.linuxfromscratch.org/BLFS/mailx/heirloom-mailx_12.5.orig.tar.gz">
                      https://anduin.linuxfromscratch.org/BLFS/mailx/heirlo=
om-mailx_12.5.orig.tar.gz</a>
                    </p>
                  </li>
                  <li class=3D"listitem">
                    <p>
                      Download MD5 sum: 29a6033ef1412824d02eb9d9213cb1f2
                    </p>
                  </li>
                  <li class=3D"listitem">
                    <p>
                      Download size: 317 KB
                    </p>
                  </li>
                  <li class=3D"listitem">
                    <p>
                      Estimated disk space required: 3.2 MB
                    </p>
                  </li>
                  <li class=3D"listitem">
                    <p>
                      Estimated build time: less than 0.1 SBU
                    </p>
                  </li>
                </ul>
              </div>
              <h4>
                <a id=3D"idm140470503612528" name=3D"idm140470503612528"></=
a>Additional Downloads
              </h4>
              <div class=3D"itemizedlist">
                <ul class=3D"compact">
                  <li class=3D"listitem">
                    <p>
                      Required patch: <a class=3D"ulink" href=3D"https://ww=
w.linuxfromscratch.org/patches/blfs/12.2/heirloom-mailx-12.5-fixes-1.patch"=
>
                      https://www.linuxfromscratch.org/patches/blfs/12.2/he=
irloom-mailx-12.5-fixes-1.patch</a>
                    </p>
                  </li>
                </ul>
              </div>
              <h4>
                <a id=3D"idm140470503609776" name=3D"idm140470503609776"></=
a>Heirloom mailx Dependencies
              </h4>
              <h5>
                <a id=3D"idm140470503609072" name=3D"idm140470503609072"></=
a>Optional
              </h5>
              <p class=3D"optional">
                <a class=3D"xref" href=3D"https://www.linuxfromscratch.org/=
blfs/downloads/stable/BLFS-BOOK-12.2-sysv-nochunks.html#nss" title=3D"NSS-3=
.103">nss-3.103</a>,
                <a class=3D"xref" href=3D"https://www.linuxfromscratch.org/=
blfs/downloads/stable/BLFS-BOOK-12.2-sysv-nochunks.html#mitkrb" title=3D"MI=
T Kerberos V5-1.21.3">MIT Kerberos V5-1.21.3</a> (for IMAP
                GSSAPI authentication), and an <a class=3D"xref" href=3D"ht=
tps://www.linuxfromscratch.org/blfs/downloads/stable/BLFS-BOOK-12.2-sysv-no=
chunks.html#server-mail" title=3D"Chapter&nbsp;21.&nbsp;Mail Server Softwar=
e">MTA</a>
              </p>
            </div>
            <div class=3D"installation" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Installation of Heirloom mailx
              </h3>
              <div class=3D"admon note">
                <h3>
                  Note
                </h3>
                <p>
                  This package does not support parallel build.
                </p>
              </div>
              <p>
                Install <span class=3D"application">Heirloom mailx</span> b=
y
                running the following commands.
              </p>
              <pre class=3D"userinput"><kbd class=3D"command">patch -Np1 -i=
 ../heirloom-mailx-12.5-fixes-1.patch &amp;&amp;

sed 's@&lt;openssl@&lt;openssl-1.0/openssl@' \
    -i openssl.c fio.c makeconfig      &amp;&amp;

make -j1 LDFLAGS+=3D"-L /usr/lib/openssl/" \
         SENDMAIL=3D/usr/sbin/sendmail</kbd></pre>
              <p>
                This package does not come with a test suite.
              </p>
              <p>
                Now, as the <code class=3D"systemitem">root</code> user:
              </p>
              <pre class=3D"root"><kbd class=3D"command">make PREFIX=3D/usr=
 UCBINSTALL=3D/usr/bin/install install &amp;&amp;

ln -v -sf mailx /usr/bin/mail &amp;&amp;
ln -v -sf mailx /usr/bin/nail &amp;&amp;

install -v -m755 -d     /usr/share/doc/heirloom-mailx-12.5 &amp;&amp;
install -v -m644 README /usr/share/doc/heirloom-mailx-12.5</kbd></pre>
            </div>
            <div class=3D"commands" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Command Explanations
              </h3>
              <p>
                <span class=3D"command"><strong>make
                SENDMAIL=3D/usr/sbin/sendmail</strong></span>: This changes=
 the
                default MTA path of <span class=3D"command"><strong>/usr/li=
b/sendmail</strong></span>.
              </p>
              <p>
                <span class=3D"command"><strong>make PREFIX=3D/usr
                UCBINSTALL=3D/usr/bin/install install</strong></span>: This
                changes the default installation path of <code class=3D"fil=
ename">/usr/local</code> and the default <span class=3D"command"><strong>in=
stall</strong></span> command path of
                <code class=3D"filename">/usr/ucb</code>.
              </p>
            </div>
            <div class=3D"configuration" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Configuring Heirloom mailx
              </h3>
              <div class=3D"sect3" lang=3D"en" xml:lang=3D"en">
                <div class=3D"titlepage">
                  <div>
                    <div>
                      <h4 class=3D"title">
                        <a id=3D"mailx-config" name=3D"mailx-config"></a>Co=
nfig
                        Files
                      </h4>
                    </div>
                  </div>
                </div>
                <p>
                  <code class=3D"filename">/etc/nail.rc</code> and <code cl=
ass=3D"filename">~/.mailrc</code>
                </p>
              </div>
              <div class=3D"sect3" lang=3D"en" xml:lang=3D"en">
                <div class=3D"titlepage">
                  <div>
                    <div>
                      <h4 class=3D"title">
                        <a id=3D"idm140470503581184" name=3D"idm14047050358=
1184"></a>Configuration Information
                      </h4>
                    </div>
                  </div>
                </div>
                <p>
                  For displaying mails, <span class=3D"application">mailx</=
span> uses a pager program. Since the
                  default of <span class=3D"command"><strong>pg</strong></s=
pan>
                  is not available on a LFS system, its required to specify
                  which pager is to use. By default, there is <span class=
=3D"command"><strong>more</strong></span> and the more
                  comfortable <span class=3D"command"><strong>less</strong>=
</span> installed. If the
                  variable PAGER is not set in <code class=3D"filename">/et=
c/profile</code> or <code class=3D"filename">~/.bash_profile</code>, or if =
it should be
                  another pager just for reading mails, it can be set syste=
m
                  wide in <code class=3D"filename">/etc/nail.rc</code>:
                </p>
                <pre class=3D"userinput"><kbd class=3D"command">echo "set P=
AGER=3D<em class=3D"replaceable"><code>&lt;more|less&gt;</code></em>" &gt;&=
gt; /etc/nail.rc</kbd></pre>
                <p>
                  or individually for the actual user in <code class=3D"fil=
ename">~/.mailrc</code>:
                </p>
                <pre class=3D"userinput"><kbd class=3D"command">echo "set P=
AGER=3D<em class=3D"replaceable"><code>&lt;more|less&gt;</code></em>" &gt;&=
gt; ~/.mailrc</kbd></pre>
                <p>
                  Other interesting options to set in the config files migh=
t
                  be EDITOR and MAILDIR.
                </p>
                <p>
                  If not set in the environment for other packages, the
                  default editor can be set by:
                </p>
                <pre class=3D"userinput"><kbd class=3D"command">echo "set E=
DITOR=3D<em class=3D"replaceable"><code>&lt;vim|nano|...&gt;</code></em>" &=
gt;&gt; /etc/nail.rc</kbd></pre>
                <p>
                  Depending on which kind of <a class=3D"xref" href=3D"http=
s://www.linuxfromscratch.org/blfs/downloads/stable/BLFS-BOOK-12.2-sysv-noch=
unks.html#server-mail" title=3D"Chapter&nbsp;21.&nbsp;Mail Server Software"=
>MTA</a> is
                  installed, it might be required to set the MAILDIR variab=
le
                  so <span class=3D"application">mailx</span> is able to fi=
nd
                  the mails:
                </p>
                <pre class=3D"userinput"><kbd class=3D"command">echo "set M=
AILDIR=3DMaildir" &gt;&gt; /etc/nail.rc</kbd></pre>
              </div>
            </div>
            <div class=3D"content" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Contents
              </h3>
              <div class=3D"segmentedlist">
                <div class=3D"seglistitem">
                  <div class=3D"seg">
                    <strong class=3D"segtitle">Installed Programs:</strong>
                    <span class=3D"segbody">mail, mailx and nail</span>
                  </div>
                  <div class=3D"seg">
                    <strong class=3D"segtitle">Installed Libraries:</strong=
>
                    <span class=3D"segbody">None</span>
                  </div>
                  <div class=3D"seg">
                    <strong class=3D"segtitle">Installed Directories:</stro=
ng>
                    <span class=3D"segbody">None</span>
                  </div>
