"(/apps):"/org/gnome\1:' data/*.xml &amp;&amp;

mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=3D/usr --buildtype=3Drelease .. &amp;&amp;
ninja</kbd></pre>
              <p>
                This package does not come with a test suite.
              </p>
              <p>
                Now, as the <code class=3D"systemitem">root</code> user:
              </p>
