                <code class=3D"systemitem">root</code> user:
              </p>
              <pre class=3D"root"><kbd class=3D"command">install -vdm755 /u=
sr/share/xml/docbook/schema/{dtd,rng,sch,xsd}/5.0 &amp;&amp;
install -vm644  dtd/* /usr/share/xml/docbook/schema/dtd/5.0         &amp;&a=
mp;
install -vm644  rng/* /usr/share/xml/docbook/schema/rng/5.0         &amp;&a=
mp;
install -vm644  sch/* /usr/share/xml/docbook/schema/sch/5.0         &amp;&a=
