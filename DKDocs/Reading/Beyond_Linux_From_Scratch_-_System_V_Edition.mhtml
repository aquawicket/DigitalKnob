                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"mailstats" name=3D"mailstats"></a><span =
class=3D"term"><span class=3D"command"><strong>mailstats</strong></span></s=
pan>
                        </p>
                      </td>
                      <td>
                        <p>
                          displays <span class=3D"application">sendmail</sp=
an>
                          statistics
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"mailq-sendmail" name=3D"mailq-sendmail">=
</a><span class=3D"term"><span class=3D"command"><strong>mailq</strong></sp=
an></span>
                        </p>
