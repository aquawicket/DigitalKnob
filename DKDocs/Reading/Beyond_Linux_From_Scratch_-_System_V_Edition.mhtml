ig"></a>Config Files
                      </h4>
                    </div>
                  </div>
                </div>
                <p>
                  <code class=3D"filename">/etc/ant/ant.conf</code>,
                  <code class=3D"filename">~/.ant/ant.conf</code>, and
                  <code class=3D"filename">~/.antrc</code>
                </p>
              </div>
              <div class=3D"sect3" lang=3D"en" xml:lang=3D"en">
                <div class=3D"titlepage">
                  <div>
                    <div>
                      <h4 class=3D"title">
                        <a id=3D"idm140470507762416" name=3D"idm14047050776=
2416"></a>Configuration Information
                      </h4>
                    </div>
                  </div>
                </div>
                <p>
                  Some packages will require <span class=3D"command"><stron=
g>ant</strong></span> to be in the search
                  path and the <code class=3D"envar">ANT_HOME</code>
                  environment variable defined. Satisfy these requirements =
by
                  issuing, as the <code class=3D"systemitem">root</code> us=
er:
                </p>
                <pre class=3D"root"><kbd class=3D"command">cat &gt; /etc/pr=
ofile.d/ant.sh &lt;&lt; EOF
<code class=3D"literal"># Begin /etc/profile.d/ant.sh

pathappend /opt/ant/bin
export ANT_HOME=3D/opt/ant

# End /etc/profile.d/ant.sh</code>
EOF</kbd></pre>
                <p>
                  The above instructions assume you have configured your
                  system as described in <a class=3D"xref" href=3D"https://=
www.linuxfromscratch.org/blfs/downloads/stable/BLFS-BOOK-12.2-sysv-nochunks=
.html#postlfs-config-profile" title=3D"The Bash Shell Startup Files">The Ba=
sh Shell Startup
                  Files</a>.
                </p>
              </div>
