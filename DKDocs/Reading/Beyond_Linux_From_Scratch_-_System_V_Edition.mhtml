                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"libsqlite3" name=3D"libsqlite3"></a><spa=
n class=3D"term"><code class=3D"filename">libsqlite3.so</code></span>
                        </p>
                      </td>
