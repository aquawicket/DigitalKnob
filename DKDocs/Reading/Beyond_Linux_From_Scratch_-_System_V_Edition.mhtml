                        <p>
                          <a id=3D"dmeventd" name=3D"dmeventd"></a><span cl=
ass=3D"term"><span class=3D"command"><strong>dmeventd</strong></span></span=
>
                        </p>
                      </td>
                      <td>
                        <p>
                          (optional) is the Device Mapper event daemon
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"dmsetup" name=3D"dmsetup"></a><span clas=
s=3D"term"><span class=3D"command"><strong>dmsetup</strong></span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          is a low level logical volume management tool
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"fsadm" name=3D"fsadm"></a><span class=3D=
"term"><span class=3D"command"><strong>fsadm</strong></span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          is a utility used to resize or check filesystem o=
n
                          a device
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"lvm" name=3D"lvm"></a><span class=3D"ter=
m"><span class=3D"command"><strong>lvm</strong></span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          provides the command-line tools for <span class=
