                    <span class=3D"segbody">libinproctrace.so</span>
                  </div>
                  <div class=3D"seg">
                    <strong class=3D"segtitle">Installed Directories:</stro=
ng>
                    <span class=3D"segbody">/usr/{include,share}/gdb and
                    /usr/share/doc/gdb-15.1</span>
                  </div>
                </div>
              </div>
              <div class=3D"variablelist">
                <h4>
                  <a id=3D"idm140470517272752" name=3D"idm140470517272752">=
</a>Short Descriptions
                </h4>
                <table border=3D"0" class=3D"variablelist">
                  <colgroup>
                    <col align=3D"left" valign=3D"top">
                    <col>
                  </colgroup>
                  <tbody>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"gcore" name=3D"gcore"></a><span class=3D=
"term"><span class=3D"command"><strong>gcore</strong></span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          generates a core dump of a running program
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"gdb-prog" name=3D"gdb-prog"></a><span cl=
ass=3D"term"><span class=3D"command"><strong>gdb</strong></span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          is the GNU Debugger
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"gdbserver" name=3D"gdbserver"></a><span =
class=3D"term"><span class=3D"command"><strong>gdbserver</strong></span></s=
pan>
                        </p>
                      </td>
                      <td>
                        <p>
                          is a remote server for the GNU debugger (it allow=
s
                          programs to be debugged from a different machine)
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"gdb-add-index" name=3D"gdb-add-index"></=
a><span class=3D"term"><span class=3D"command"><strong>gdb-add-index</stron=
g></span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          Allows adding index files to ELF binaries. This
                          speeds up <span class=3D"command"><strong>gdb</st=
rong></span> start on
                          large programs.
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"libinproctrace" name=3D"libinproctrace">=
</a><span class=3D"term"><code class=3D"filename">libinproctrace.so</code><=
/span>
                        </p>
                      </td>
                      <td>
                        <p>
                          contains functions for the in-process tracing
                          agent. The agent allows for installing fast
                          tracepoints, listing static tracepoint markers,
                          probing static tracepoints markers, and starting
                          trace monitoring.
                        </p>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
