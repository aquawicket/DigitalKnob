      &amp;&amp;
tar -xf ../dconf-editor-45.0.1.tar.xz &amp;&amp;
cd dconf-editor-45.0.1                &amp;&amp;

mkdir build &amp;&amp;
cd    build &amp;&amp;

meson setup --prefix=3D/usr --buildtype=3Drelease .. &amp;&amp;
ninja</kbd></pre>
