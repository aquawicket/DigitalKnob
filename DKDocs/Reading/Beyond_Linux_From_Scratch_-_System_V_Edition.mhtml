                    <span class=3D"segbody">libsqlite3.so</span>
                  </div>
                  <div class=3D"seg">
                    <strong class=3D"segtitle">Installed Directory:</strong=
>
                    <span class=3D"segbody">/usr/share/doc/sqlite-3.46.1</s=
pan>
                  </div>
                </div>
              </div>
