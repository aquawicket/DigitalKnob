              <p>
                Install <span class=3D"application">Cdrtools</span> by runn=
ing
                the following commands:
              </p>
              <pre class=3D"userinput"><kbd class=3D"command">sed -i 's|/op=
t/schily|/usr|g'           DEFAULTS/Defaults.linux &amp;&amp;
sed -i 's|DEFINSGRP=3D.*|DEFINSGRP=3Droot|' DEFAULTS/Defaults.linux &amp;&a=
mp;
sed -i 's|INSDIR=3D\s*sbin|INSDIR=3Dbin|'   rscsi/Makefile          &amp;&a=
mp;

export GMAKE_NOWARN=3Dtrue &amp;&amp;
export CFLAGS=3D"$CFLAGS -std=3Dgnu89 -fno-strict-aliasing" &amp;&amp;

make -j1 INS_BASE=3D/usr  \
         DEFINSUSR=3Droot \
         DEFINSGRP=3Droot \
         VERSION_OS=3D"LinuxFromScratch"</kbd></pre>
              <p>
                This package does not come with a test suite.
              </p>
