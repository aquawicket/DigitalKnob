            <div class=3D"kernel" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                <a id=3D"NetworkManager-kernel" name=3D"NetworkManager-kern=
el"></a>Kernel Configuration
              </h3>
              <p>
