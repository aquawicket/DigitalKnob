                  <colgroup>
                    <col align=3D"left" valign=3D"top">
                    <col>
                  </colgroup>
                  <tbody>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"abiword-prog" name=3D"abiword-prog"></a>=
<span class=3D"term"><span class=3D"command"><strong>abiword</strong></span=
></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          is the word processor, a wrapper for the function=
s
                          in libabiword-3.0 - it can also be used on the
                          command line, see <span class=3D"command"><strong=
>man
                          1 abiword</strong></span>
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"libabiword" name=3D"libabiword"></a><spa=
n class=3D"term"><code class=3D"filename">libabiword-3.0.so</code></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          provides functions to access MS Word documents
                        </p>
                      </td>
