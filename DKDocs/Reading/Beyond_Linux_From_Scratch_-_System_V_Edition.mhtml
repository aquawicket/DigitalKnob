                    <col>
                  </colgroup>
                  <tbody>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"fatlabel" name=3D"fatlabel"></a><span cl=
ass=3D"term"><span class=3D"command"><strong>fatlabel</strong></span></span=
>
                        </p>
                      </td>
                      <td>
                        <p>
                          sets or gets a MS-DOS filesystem label from a giv=
en
                          device
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"fsckfat" name=3D"fsckfat"></a><span clas=
s=3D"term"><span class=3D"command"><strong>fsck.fat</strong></span></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          checks and repairs MS-DOS filesystems
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"mkfsfat" name=3D"mkfsfat"></a><span clas=
s=3D"term"><span class=3D"command"><strong>mkfs.fat</strong></span></span>
                        </p>
                      </td>
