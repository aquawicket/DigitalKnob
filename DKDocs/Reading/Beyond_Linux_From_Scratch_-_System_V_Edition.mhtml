                    <col align=3D"left" valign=3D"top">
                    <col>
                  </colgroup>
                  <tbody>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"aspell-prog" name=3D"aspell-prog"></a><s=
pan class=3D"term"><span class=3D"command"><strong>aspell</strong></span></=
span>
                        </p>
                      </td>
                      <td>
                        <p>
                          is a utility that can function as an <span class=
=3D"command"><strong>ispell -a</strong></span>
