                <ul class=3D"compact">
                  <li class=3D"listitem">
                    <p>
                      Download (HTTP): <a class=3D"ulink" href=3D"https://f=
tp.exim.org/pub/exim/exim4/exim-4.98.tar.xz">https://ftp.exim.org/pub/exim/=
exim4/exim-4.98.tar.xz</a>
                    </p>
                  </li>
                  <li class=3D"listitem">
                    <p>
                      Download MD5 sum: f9f4573ba47402364ea71cb3d791b03c
                    </p>
                  </li>
