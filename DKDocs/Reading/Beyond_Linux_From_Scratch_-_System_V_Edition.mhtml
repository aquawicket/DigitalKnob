                  <li class=3D"listitem">
                    <p>
                      [F6] - toggle toolbar
                    </p>
                  </li>
                  <li class=3D"listitem">
                    <p>
                      [F7] - toggle menu
                    </p>
                  </li>
                  <li class=3D"listitem">
                    <p>
                      [F8] - toggle invert-colors
                    </p>
                  </li>
                  <li class=3D"listitem">
                    <p>
                      [F9] - toggle show-index
                    </p>
                  </li>
                  <li class=3D"listitem">
                    <p>
                      [F11] - toggle fullscreen
                    </p>
                  </li>
                </ul>
              </div>
