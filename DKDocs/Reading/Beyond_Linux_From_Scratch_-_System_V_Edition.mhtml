ng>
                    <span class=3D"segbody">/{etc,lib,var/lib}/stunnel and
                    /usr/share/doc/stunnel-5.72</span>
                  </div>
                </div>
              </div>
              <div class=3D"variablelist">
                <h4>
                  <a id=3D"idm140470533792208" name=3D"idm140470533792208">=
</a>Short Descriptions
                </h4>
                <table border=3D"0" class=3D"variablelist">
                  <colgroup>
                    <col align=3D"left" valign=3D"top">
                    <col>
                  </colgroup>
                  <tbody>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"stunnel-prog" name=3D"stunnel-prog"></a>=
<span class=3D"term"><span class=3D"command"><strong>stunnel</strong></span=
></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          is a program designed to work as an SSL encryptio=
n
                          wrapper between remote clients and local or remot=
e
                          servers
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"stunnel3" name=3D"stunnel3"></a><span cl=
ass=3D"term"><span class=3D"command"><strong>stunnel3</strong></span></span=
>
                        </p>
                      </td>
                      <td>
                        <p>
                          is a <span class=3D"application">Perl</span> wrap=
per
                          script to use <span class=3D"command"><strong>stu=
nnel</strong></span> 3.x
                          syntax with <span class=3D"command"><strong>stunn=
el</strong></span> 4.05 or
                          later
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"libstunnel" name=3D"libstunnel"></a><spa=
n class=3D"term"><code class=3D"filename">libstunnel.so</code></span>
                        </p>
                      </td>
                      <td>
                        <p>
                          contains the API functions required by <span clas=
s=3D"application">stunnel</span>
