pypi.org/project/pyasn1/">pyasn1</a>, <a class=3D"ulink" href=3D"https://te=
vent.samba.org/">tevent</a>
                (included), <a class=3D"ulink" href=3D"https://tdb.samba.or=
g/">tdb</a> (included), and <a class=3D"ulink" href=3D"https://download.gno=
me.org/sources/tracker/2.3/">tracker-2</a>
              </p>
              <h5>
                <a id=3D"idm140470506683088" name=3D"idm140470506683088"></=
a>Optional (for the Developer Test
                Suite)
              </h5>
              <p class=3D"optional">
                Install in listed order: <a class=3D"xref" href=3D"https://=
www.linuxfromscratch.org/blfs/downloads/stable/BLFS-BOOK-12.2-sysv-nochunks=
.html#six" title=3D"six-1.16.0">six-1.16.0</a>, <a class=3D"xref" href=3D"h=
ttps://www.linuxfromscratch.org/blfs/downloads/stable/BLFS-BOOK-12.2-sysv-n=
ochunks.html#pytest" title=3D"Pytest-8.3.2">pytest-8.3.2</a>, <a class=3D"u=
link" href=3D"https://pypi.python.org/pypi/argparse/">argparse</a>,
                <a class=3D"ulink" href=3D"https://pypi.python.org/pypi/tes=
ttools/">testtools</a>,
                <a class=3D"ulink" href=3D"https://pypi.python.org/pypi/tes=
tscenarios/">testscenarios</a>,
                and <a class=3D"ulink" href=3D"https://pypi.python.org/pypi=
/python-subunit/">python-subunit</a>
              </p>
              <p class=3D"usernotes">
                Editor Notes: <a class=3D"ulink" href=3D"https://wiki.linux=
fromscratch.org/blfs/wiki/samba4">https://wiki.linuxfromscratch.org/blfs/wi=
ki/samba4</a>
              </p>
            </div>
            <div class=3D"installation" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Installation of Samba
              </h3>
              <p>
                To support the test suite, set up a Python virtual
                environment for some Python modules out of the scope of BLF=
S:
              </p>
              <pre class=3D"userinput"><kbd class=3D"command">python3 -m ve=
nv pyvenv &amp;&amp;
./pyvenv/bin/pip3 install cryptography pyasn1 iso8601</kbd></pre>
              <p>
                Install <span class=3D"application">Samba</span> by running=
 the
                following commands:
              </p>
              <pre class=3D"userinput"><kbd class=3D"command">PYTHON=3D$PWD=
/pyvenv/bin/python3             \
PATH=3D$PWD/pyvenv/bin:$PATH                 \
./configure                                \
    --prefix=3D/usr                          \
    --sysconfdir=3D/etc                      \
    --localstatedir=3D/var                   \
    --with-piddir=3D/run/samba               \
    --with-pammodulesdir=3D/usr/lib/security \
    --enable-fhs                           \
    --without-ad-dc                        \
    --without-systemd                      \
    --with-system-mitkrb5                  \
    --enable-selftest                      \
    --disable-rpath-install                &amp;&amp;
make</kbd></pre>
              <p>
                To test the results, issue: <span class=3D"command"><strong=
>PATH=3D$PWD/pyvenv/bin:$PATH make
                quicktest</strong></span>. The test suite will produce line=
s
                that look like failures, but these are innocuous. The last
                few lines of output should report <span class=3D"emphasis">=
<em>"ALL OK"</em></span> for a good test run. A
                summary of any failures can be found in <code class=3D"file=
name">./st/summary</code>.
              </p>
              <div class=3D"admon note">
                <h3>
                  Note
                </h3>
                <p>
                  Additionally, developer test suites are available. If
                  you've installed the optional python modules above in the
                  Python virtual environment for building this package, you
                  can run these tests with <span class=3D"command"><strong>=
make
                  test</strong></span>. It is not recommended for the avera=
ge
                  builder at around 290 SBU and over a gigabyte of disk
                  space, and you should expect ~73 errors and ~30 failures
                  from the 3000+ tests.
                </p>
              </div>
              <p>
                Fix hard coded paths to Python 3 interpreter:
              </p>
              <pre class=3D"userinput"><kbd class=3D"command">sed '1s@^.*$@=
#!/usr/bin/python3@' \
    -i ./bin/default/source4/scripting/bin/*.inst</kbd></pre>
              <p>
                If upgrading from an old version of samba, as the
                <code class=3D"systemitem">root</code> user, remove the old
                Python support files to prevent some issues:
              </p>
              <pre class=3D"root"><kbd class=3D"command">rm -rf /usr/lib/py=
thon3.12/site-packages/samba</kbd></pre>
              <p>
                Still as the <code class=3D"systemitem">root</code> user,
                install the package:
              </p>
              <pre class=3D"root"><kbd class=3D"command">make install &amp;=
&amp;

install -v -m644    examples/smb.conf.default /etc/samba &amp;&amp;

sed -e "s;log file =3D.*;log file =3D /var/log/samba/%m.log;" \
    -e "s;path =3D /usr/spool/samba;path =3D /var/spool/samba;" \
    -i /etc/samba/smb.conf.default &amp;&amp;

mkdir -pv /etc/openldap/schema                        &amp;&amp;

install -v -m644    examples/LDAP/README              \
                    /etc/openldap/schema/README.samba &amp;&amp;

install -v -m644    examples/LDAP/samba*              \
                    /etc/openldap/schema              &amp;&amp;

install -v -m755    examples/LDAP/{get*,ol*} \
                    /etc/openldap/schema</kbd></pre>
            </div>
            <div class=3D"commands" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Command Explanations
              </h3>
              <p>
                <em class=3D"parameter"><code>--enable-fhs</code></em>: Ass=
igns
                all other file paths in a manner compliant with the
                Filesystem Hierarchy Standard (FHS).
              </p>
              <p>
                <em class=3D"parameter"><code>--without-systemd</code></em>=
:
                Disable <span class=3D"application">systemd</span> integrat=
ion,
                since it is not built in the System V version of LFS/BLFS.
              </p>
              <p>
                <code class=3D"option">--with-shared-modules=3D'!vfs_snappe=
r'</code>: Disable
                the vfs_snapper module if you want to build samba without
                <span class=3D"application">dbus</span> support, for setups
                without graphical user interfaces.
              </p>
              <p>
                <em class=3D"parameter"><code>--without-ad-dc</code></em>:
                Disables Active Directory Domain Controller functionality.
                See <a class=3D"ulink" href=3D"https://wiki.samba.org/index=
.php/Setup_a_Samba_Active_Directory_Domain_Controller">
                Set up a Samba Active Directory Domain Controller</a> for
                detailed information. Remove this switch if you've installe=
d
                the Python modules needed for ADS support. Note that BLFS
                does not provide a samba bootscript or systemd unit for an
                Active Directory domain controller.
              </p>
              <p>
                <em class=3D"parameter"><code>--with-system-mitkrb5</code><=
/em>: Enables
                building with the system version of Kerberos. This mitigate=
s
                security vulnerabilities and reduces build time. Remove thi=
s
                if you do not have <a class=3D"xref" href=3D"https://www.li=
nuxfromscratch.org/blfs/downloads/stable/BLFS-BOOK-12.2-sysv-nochunks.html#=
mitkrb" title=3D"MIT Kerberos V5-1.21.3">MIT Kerberos V5-1.21.3</a>
                installed.
              </p>
              <p>
                <em class=3D"parameter"><code>--disable-rpath-install</code=
></em>:
                Removes the library installation path from embedded shared
                library search paths in the installed binary executable fil=
es
                and shared libraries. When this package is installed into t=
he
                standard location the library installation path is
                <code class=3D"filename">/usr/lib</code>. It's always searc=
hed
                by the dynamic linker, so there is no need to embed it into
                installed files.
              </p>
              <p>
                <code class=3D"option">--with-selftest-prefix=3DSELFTEST_PR=
EFIX</code>: This
                option specifies the test suite work directory
                (default=3D./st).
              </p>
              <p>
                <span class=3D"command"><strong>install -v -m644
                examples/LDAP/* /etc/openldap/schema</strong></span>: These
                commands are used to copy sample Samba schemas to the
                OpenLDAP <code class=3D"filename">schema</code> directory.
              </p>
              <p>
                <span class=3D"command"><strong>install -v -m644
                ../examples/smb.conf.default /etc/samba</strong></span>: Th=
is
                copies a default <code class=3D"filename">smb.conf</code> f=
ile
                into <code class=3D"filename">/etc/samba</code>. This sampl=
e
                configuration will not work until you copy it to <code clas=
s=3D"filename">/etc/samba/smb.conf</code> and make the
                appropriate changes for your installation. See the
                configuration section for minimum values which must be set.
              </p>
            </div>
            <div class=3D"configuration" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Configuring Samba
              </h3>
              <div class=3D"sect3" lang=3D"en" xml:lang=3D"en">
                <div class=3D"titlepage">
                  <div>
                    <div>
                      <h4 class=3D"title">
                        <a id=3D"samba-config" name=3D"samba-config"></a>Co=
nfig
                        Files
                      </h4>
                    </div>
                  </div>
                </div>
                <p>
                  /etc/samba/smb.conf
                </p>
              </div>
              <div class=3D"sect3" lang=3D"en" xml:lang=3D"en">
                <div class=3D"titlepage">
                  <div>
                    <div>
                      <h4 class=3D"title">
                        <a id=3D"idm140470506630720" name=3D"idm14047050663=
0720"></a>Printing to SMB Clients
                      </h4>
                    </div>
                  </div>
                </div>
                <p>
                  If you use <span class=3D"application">CUPS</span> for pr=
int
                  services, and you wish to print to a printer attached to =
an
                  SMB client, you need to create an SMB backend device. To
                  create the device, issue the following command as the
                  <code class=3D"systemitem">root</code> user:
                </p>
                <pre class=3D"root"><kbd class=3D"command">install -dvm 755=
 /usr/lib/cups/backend &amp;&amp;
ln -v -sf /usr/bin/smbspool /usr/lib/cups/backend/smb</kbd></pre>
              </div>
              <div class=3D"sect3" lang=3D"en" xml:lang=3D"en">
                <div class=3D"titlepage">
                  <div>
                    <div>
                      <h4 class=3D"title">
                        <a id=3D"idm140470506625984" name=3D"idm14047050662=
5984"></a>Configuration Information
                      </h4>
                    </div>
                  </div>
                </div>
                <p>
                  Due to the complexity and the many various uses for
                  <span class=3D"application">Samba</span>, complete
                  configuration for all the package's capabilities is well
                  beyond the scope of the BLFS book. This section provides
                  instructions to configure the <code class=3D"filename">/e=
tc/samba/smb.conf</code> file for two common
                  scenarios. The complete contents of <code class=3D"filena=
me">/etc/samba/smb.conf</code> will depend on the
                  purpose of <span class=3D"application">Samba</span>
                  installation.
                </p>
                <div class=3D"admon note">
                  <h3>
                    Note
                  </h3>
                  <p>
                    You may find it easier to copy the configuration
                    parameters shown below into an empty <code class=3D"fil=
ename">/etc/samba/smb.conf</code> file instead of
                    copying and editing the default file as mentioned in th=
e
                    <span class=3D"quote">=E2=80=9C<span class=3D"quote">Co=
mmand
                    Explanations</span>=E2=80=9D</span> section. How you cr=
eate/edit
                    the <code class=3D"filename">/etc/samba/smb.conf</code>
                    file will be left up to you. Do ensure the file is only
                    writable by the <code class=3D"systemitem">root</code> =
user
                    (mode 644).
                  </p>
                </div>
                <div class=3D"sect4">
                  <div class=3D"titlepage">
                    <div>
                      <div>
                        <h5 class=3D"title">
                          <a id=3D"idm140470506617728" name=3D"idm140470506=
617728"></a>Scenario 1: Minimal
                          Standalone Client-Only Installation
                        </h5>
                      </div>
                    </div>
                  </div>
                  <p>
                    Choose this variant if you only want to transfer files
                    using <span class=3D"command"><strong>smbclient</strong=
></span>, mount
                    Windows shares and print to Windows printers, and don't
                    want to share your files and printers to Windows
                    machines.
                  </p>
                  <p>
                    A <code class=3D"filename">/etc/samba/smb.conf</code> f=
ile
                    with the following three parameters is sufficient:
                  </p>
                  <pre class=3D"root"><code class=3D"literal">[global]
    workgroup =3D <em class=3D"replaceable"><code>WORKGROUP</code></em>
    dos charset =3D <em class=3D"replaceable"><code>cp850</code></em>
    unix charset =3D <em class=3D"replaceable"><code>ISO-8859-1</code></em>=
</code></pre>
                  <p>
                    The values in this example specify that the computer
                    belongs to a Windows workgroup named <code class=3D"lit=
eral"><em class=3D"replaceable"><code>WORKGROUP</code></em></code>, uses
                    the <code class=3D"literal"><em class=3D"replaceable"><=
code>cp850</code></em></code> character
                    set on the wire when talking to MS-DOS and MS Windows 9=
x,
                    and that the filenames are stored in the <code class=3D=
"literal"><em class=3D"replaceable"><code>ISO-8859-1</code></em></code>
                    encoding on the disk. Adjust these values appropriately
                    for your installation. The <code class=3D"literal">unix
                    charset</code> value must be the same as the output of
                    <span class=3D"command"><strong>locale
                    charmap</strong></span> when executed with the
                    <code class=3D"envar">LANG</code> variable set to your
                    preferred locale, otherwise the <span class=3D"command"=
><strong>ls</strong></span> command may not
                    display correct filenames of downloaded files.
                  </p>
                  <p>
                    There is no need to run any <span class=3D"application"=
>Samba</span> servers in this scenario, thus
                    you don't need to install the provided <span class=3D"p=
hrase">bootscripts.</span>
                  </p>
                </div>
                <div class=3D"sect4">
                  <div class=3D"titlepage">
                    <div>
                      <div>
                        <h5 class=3D"title">
                          <a id=3D"idm140470506603824" name=3D"idm140470506=
603824"></a>Scenario 2: Standalone
                          File/Print Server
                        </h5>
                      </div>
                    </div>
                  </div>
                  <p>
                    Choose this variant if you want to share your files and
                    printers to Windows machines in your workgroup in
                    addition to the capabilities described in Scenario 1.
                  </p>
                  <p>
                    In this case, the <code class=3D"filename">/etc/samba/s=
mb.conf.default</code> file may be
                    a good template to start from. Also, you should add the
                    <span class=3D"quote">=E2=80=9C<span class=3D"quote">do=
s
                    charset</span>=E2=80=9D</span> and <span class=3D"quote=
">=E2=80=9C<span class=3D"quote">unix charset</span>=E2=80=9D</span>
                    parameters to the <span class=3D"quote">=E2=80=9C<span =
class=3D"quote">[global]</span>=E2=80=9D</span> section as described in
                    Scenario 1 in order to prevent filename corruption. For
                    security reasons, you may wish to define <em class=3D"r=
eplaceable"><code>path =3D
                    /home/alice/shared-files</code></em>, assuming your use=
r
                    name is <em class=3D"replaceable"><code>alice</code></e=
m>
                    and you only want to share the files in that directory,
                    instead of your entire home. Then, replace <em class=3D=
"replaceable"><code>homes</code></em> by <em class=3D"replaceable"><code>sh=
ared-files</code></em> and change
                    also the <span class=3D"quote">=E2=80=9C<span class=3D"=
quote"><code class=3D"literal">comment</code></span>=E2=80=9D</span> if use=
d the
                    configuration file below or the <code class=3D"filename=
">/etc/samba/smb.conf.default</code> to create
                    yours.
                  </p>
                  <p>
                    The following configuration file creates a separate sha=
re
                    for each user's home directory and also makes all
                    printers available to Windows machines:
                  </p>
                  <pre class=3D"root"><code class=3D"literal">[global]
    workgroup =3D <em class=3D"replaceable"><code>WORKGROUP</code></em>
    dos charset =3D <em class=3D"replaceable"><code>cp850</code></em>
    unix charset =3D <em class=3D"replaceable"><code>ISO-8859-1</code></em>

[homes]
    comment =3D Home Directories
    browseable =3D no
    writable =3D yes

[printers]
    comment =3D All Printers
    path =3D /var/spool/samba
    browseable =3D no
    guest ok =3D no
    printable =3D yes</code></pre>
                  <p>
                    Other parameters you may wish to customize in the
                    <span class=3D"quote">=E2=80=9C<span class=3D"quote">[g=
lobal]</span>=E2=80=9D</span> section include:
                  </p>
                  <pre class=3D"root"><code class=3D"literal">    server st=
ring =3D
    security =3D
    hosts allow =3D
    load printers =3D
    log file =3D
    max log size =3D
    socket options =3D
    local master =3D</code></pre>
                  <p>
                    Reference the comments in the <code class=3D"filename">=
/etc/samba/smb.conf.default</code> file for
                    information regarding these parameters.
                  </p>
                  <p>
                    Since the <span class=3D"command"><strong>smbd</strong>=
</span> and <span class=3D"command"><strong>nmbd</strong></span> daemons ar=
e needed
                    in this case, install the <code class=3D"filename">samb=
a</code> <span class=3D"phrase">bootscript.</span> Be sure to run <span cla=
ss=3D"command"><strong>smbpasswd</strong></span> (with the
                    <code class=3D"option">-a</code> option to add users) t=
o
                    enable and set passwords for all accounts that need
                    <span class=3D"application">Samba</span> access. Using =
the
                    default <span class=3D"application">Samba</span> passdb
                    backend, any user you attempt to add will also be
                    required to exist in the <code class=3D"filename">/etc/=
passwd</code> file.
                  </p>
                </div>
                <div class=3D"sect4">
                  <div class=3D"titlepage">
                    <div>
                      <div>
                        <h5 class=3D"title">
                          <a id=3D"idm140470506582080" name=3D"idm140470506=
582080"></a>Advanced Requirements
                        </h5>
                      </div>
                    </div>
                  </div>
                  <p>
                    More complex scenarios involving domain control or
                    membership are possible. Such setups are advanced topic=
s
                    and cannot be adequately covered in BLFS. Many complete
                    books have been written on these topics alone. Note tha=
t
                    in some domain membership scenarios, the <span class=3D=
"command"><strong>winbindd</strong></span> daemon and the
                    corresponding <span class=3D"phrase">bootscript</span> =
are
                    needed.
                  </p>
                </div>
                <div class=3D"sect4">
                  <div class=3D"titlepage">
                    <div>
                      <div>
                        <h5 class=3D"title">
                          <a id=3D"idm140470506578768" name=3D"idm140470506=
578768"></a>Guest account
                        </h5>
                      </div>
                    </div>
                  </div>
                  <p>
                    The default <span class=3D"application">Samba</span>
                    installation uses the <code class=3D"systemitem">nobody=
</code> user for guest access to the
                    server. This can be overridden by setting the
                    <code class=3D"option">guest account =3D</code> paramet=
er in
                    the <code class=3D"filename">/etc/samba/smb.conf</code>
                    file. If you utilize the <code class=3D"option">guest
                    account =3D</code> parameter, ensure this user exists i=
n
                    the <code class=3D"filename">/etc/passwd</code> file.
                  </p>
                </div>
                <div class=3D"sect4">
                  <div class=3D"titlepage">
                    <div>
                      <div>
                        <h5 class=3D"title">
                          <a id=3D"samba-init" name=3D"samba-init"></a>Boot
                          Script
                        </h5>
                      </div>
                    </div>
                  </div>
                  <p>
                    For your convenience, boot scripts have been provided f=
or
                    <span class=3D"application">Samba</span>. There are two
                    included in the <a class=3D"xref" href=3D"https://www.l=
inuxfromscratch.org/blfs/downloads/stable/BLFS-BOOK-12.2-sysv-nochunks.html=
#bootscripts" title=3D"BLFS Boot Scripts">blfs-bootscripts-20240416</a>
                    package. The first, <code class=3D"filename">samba</cod=
e>,
                    will start the <span class=3D"command"><strong>smbd</st=
rong></span> and <span class=3D"command"><strong>nmbd</strong></span> daemo=
ns needed to
                    provide SMB/CIFS services. The second script,
                    <code class=3D"filename">winbind</code>, starts the
                    <span class=3D"command"><strong>winbindd</strong></span=
>
                    daemon, used for providing Windows domain services to
                    Linux clients.
                  </p>
                  <pre class=3D"root"><kbd class=3D"command">make install-s=
amba</kbd></pre>
                  <pre class=3D"root"><kbd class=3D"command">make install-w=
inbindd</kbd></pre>
                </div>
              </div>
            </div>
            <div class=3D"content" lang=3D"en" xml:lang=3D"en">
              <h3 class=3D"sect2">
                Contents
              </h3>
              <div class=3D"segmentedlist">
                <div class=3D"seglistitem">
                  <div class=3D"seg">
                    <strong class=3D"segtitle">Installed Programs:</strong>
                    <span class=3D"segbody">cifsdd, dbwrap_tool, dumpmscat,
                    eventlogadm, gentest, ldbadd, ldbdel, ldbedit, ldbmodif=
y,
                    ldbrename, ldbsearch, locktest, masktest, mdsearch,
                    mvxattr, ndrdump, net, nmbd, nmblookup, ntlm_auth,
                    oLschema2ldif, pdbedit, profiles, regdiff, regpatch,
                    regshell, regtree, rpcclient, samba-log-parser,
                    samba-gpupdate, samba-regedit, samba-tool, sharesec,
                    smbcacls, smbclient, smbcontrol, smbcquotas, smbd,
                    smbget, smbpasswd, smbspool, smbstatus, smbtar,
                    smbtorture, smbtree, tdbbackup, tdbdump, tdbrestore,
                    tdbtool, testparm, wbinfo, and winbindd</span>
                  </div>
                  <div class=3D"seg">
                    <strong class=3D"segtitle">Installed Libraries:</strong=
>
                    <span class=3D"segbody">libdcerpc-binding.so,
                    libdcerpc-samr.so, libdcerpc-server-core.so,
                    libdcerpc.so, libndr-krb5pac.so, libndr-nbt.so,
                    libndr.so, libndr-standard.so, libnetapi.so,
                    libnss_winbind.so, libnss_wins.so,
                    libsamba-credentials.so, libsamba-errors.so,
