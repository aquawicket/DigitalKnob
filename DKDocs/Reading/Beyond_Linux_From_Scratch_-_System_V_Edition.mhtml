                        <p>
                          provides Lua 5.2, modified for use with LuaTeX
                        </p>
                      </td>
                    </tr>
                    <tr>
                      <td>
                        <p>
                          <a id=3D"libtexluajit" name=3D"libtexluajit"></a>=
<span class=3D"term"><code class=3D"filename">libtexluajit.so</code></span>
                        </p>
                      </td>
