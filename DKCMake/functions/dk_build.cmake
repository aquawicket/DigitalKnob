#!/usr/bin/cmake -P
### DK.cmake ############################################################
if(NOT DEFINED DKINIT_cmake)
	if(NOT EXISTS "$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake")
		cmake_policy(SET CMP0009 NEW)
		file(GLOB_RECURSE DK_cmake "/DK.cmake")
		list(GET DK_cmake 0 DK_cmake)
		get_filename_component(DKCMAKE_FUNCTIONS_DIR "${DK_cmake}" DIRECTORY)
		set(ENV{DKCMAKE_FUNCTIONS_DIR_} "${DKCMAKE_FUNCTIONS_DIR}/")
	endif()
	include("$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake")
endif()
#########################################################################

### TODO ###
# switch to using install() instead of file(INSTALL ...) so we can use cmake --install and so
# different dependencies are taken into account when installing everything
function(install_libs)
	if(INSTALL_DKLIBS)
		dk_info("Installing ${CURRENT_PLUGIN} Binary files")
		set(${CURRENT_PLUGIN}_DKBIN "${CMAKE_INSTALL_PREFIX}/${CURRENT_PLUGIN}")
		file(INSTALL DIRECTORY "${${CURRENT_PLUGIN}}/" DESTINATION "${${CURRENT_PLUGIN}_DKBIN}" FILES_MATCHING PATTERN "*.a")
		file(INSTALL DIRECTORY "${${CURRENT_PLUGIN}}/" DESTINATION "${${CURRENT_PLUGIN}_DKBIN}" FILES_MATCHING PATTERN "*.lib")
		file(INSTALL DIRECTORY "${${CURRENT_PLUGIN}}/" DESTINATION "${${CURRENT_PLUGIN}_DKBIN}" FILES_MATCHING PATTERN "*.exe")
		file(INSTALL DIRECTORY "${${CURRENT_PLUGIN}}/assets" DESTINATION "${${CURRENT_PLUGIN}_DKBIN}/assets" FILES_MATCHING PATTERN "*.*")
		#dk_deleteEmptyDirectories("${CMAKE_INSTALL_PREFIX}/include/${Plugin}")
	endif()
endfunction()
		
		
