		if(EXISTS "${Config_Dir}/cmake_install.cmake")
			dk_validate(cmake_exe "dk_depend(cmake)")
			if(target)
				if(Debug)
					dk_echo("\n###### Building $ENV{CURRENT_PLUGIN}_${target}_Debug with CMake ######")
					dk_exec(${cmake_exe} --build "${Config_Dir}" --config Debug --target ${target} --verbose)# -- -d)
				endif()
				if(Release)
					dk_echo("\n###### Building $ENV{CURRENT_PLUGIN}_${target}_Release with CMake ######")
					dk_exec(${cmake_exe} --build "${Config_Dir}" --config Release --target ${target} --verbose)# -- -d)
				endif()
			else()
				if(Debug)
					dk_echo("\n###### Building $ENV{CURRENT_PLUGIN}_Debug with CMake ######")
					dk_exec(${cmake_exe} --build "${Config_Dir}" --config Debug --verbose)# -- -d)
				endif()
				if(Release)
					dk_echo("\n###### Building $ENV{CURRENT_PLUGIN}_Release with CMake ######")
					dk_exec(${cmake_exe} --build "${Config_Dir}" --config Release --verbose)# -- -d)
				endif()
			endif()
			install_libs()
			dk_return()
