#!/usr/bin/cmake -P
### DK.cmake ############################################################
if(NOT EXISTS "$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake")
	cmake_policy(SET CMP0009 NEW)
	file(GLOB_RECURSE DK.cmake "/DK.cmake")
	list(GET DK.cmake 0 DK.cmake)
	get_filename_component(DKCMAKE_FUNCTIONS_DIR "${DK.cmake}" DIRECTORY)
	set(ENV{DKCMAKE_FUNCTIONS_DIR_} "${DKCMAKE_FUNCTIONS_DIR}/")
endif()
include("$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake")
include_guard()
#########################################################################


#########################################################################
# dk_generateCmake(Source_Dir)
#
#	Generate a CMakeLists.txt for the given path
#
#	@Source_Dir	- TODO
#
function(dk_generateCmake)
	dk_debugFunc(0 1)

	dk_assertPath(${CURRENT_PLUGIN})
	dk_basename("${${CURRENT_PLUGIN}}")
	set(Plugin_Name "${dk_basename}")
	
	if(ARGV)
		set(Source_Dir "${ARGV0}")
	else()
		set(Source_Dir "${${CURRENT_PLUGIN}}")
	endif()
	dk_assertPath(Source_Dir)

	if(NOT "${SOURCE_DIR}" STREQUAL "${${CURRENT_PLUGIN}}")
		dk_notice("dk_generateCmake(): Source_Dir:${Source_Dir} != CURRENT_PLUGIN:${${CURRENT_PLUGIN}}")
	endif()
	
	###### Create CmakeLists.txt file ######
	dk_delete(${Source_Dir}/CMakeLists.txt)
	dk_fileWrite(${Source_Dir}/CMakeLists.txt "### This file is generated by DKCMake. Any Changes here, will be overwritten. ###\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "### ${Plugin_Name} ###\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "cmake_minimum_required(VERSION 3.10)\n")
	#dk_fileAppend(${Source_Dir}/CMakeLists.txt "cmake_policy(SET CMP0054 NEW)\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "project(${Plugin_Name})\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "include_directories(${DKCPP_PLUGINS_DIR})\n")
	foreach(each_include ${DKINCLUDES_LIST})
		dk_fileAppend(${Source_Dir}/CMakeLists.txt "include_directories(${each_include})\n")
	endforeach()
	foreach(each_define ${DKDEFINES_LIST})
		dk_fileAppend(${Source_Dir}/CMakeLists.txt "add_definitions(-D${each_define})\n")
	endforeach()
	foreach(each_linkdir ${DKLINKDIRS_LIST})
		dk_fileAppend(${Source_Dir}/CMakeLists.txt "link_directories(${each_linkdir})\n")
	endforeach()	
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "file(GLOB ${Plugin_Name}_SRC\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		${Source_Dir}/*.h\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		${Source_Dir}/*.c\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		${Source_Dir}/*.cpp\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt ")\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "if(Windows)\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		file(GLOB WIN_SRC\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "			${Source_Dir}/*.rc\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "			${Source_Dir}/*.manifest\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		)\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		list(APPEND ${Plugin_Name}_SRC \${WIN_SRC})\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "endif()\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "if(IOS OR Iossim)\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		file(GLOB IOS_SRC\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "			${Source_Dir}/*.mm\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		)\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		list(APPEND ${Plugin_Name}_SRC \${IOS_SRC})\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "endif()\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "add_library(${Plugin_Name} STATIC \${${Plugin_Name}_SRC})\n")
	#dk_fileAppend(${Source_Dir}/CMakeLists.txt "target_compile_options(${Plugin_Name} PRIVATE \${CMAKE_CXX_FLAGS} $<$<CONFIG:Debug>:\${CMAKE_CXX_FLAGS_DEBUG}> $<$<CONFIG:Release>:\${CMAKE_CXX_FLAGS_RELEASE}>)\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "if(MSVC)\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "set_target_properties(${Plugin_Name} PROPERTIES LINKER_LANGUAGE CPP)\n") 
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "		set_property(DIRECTORY \${CMAKE_CURRENT_SOURCE_DIR} PROPERTY VS_STARTUP_PROJECT ${Plugin_Name})\n")
	dk_fileAppend(${Source_Dir}/CMakeLists.txt "endif()\n")
	#dk_fileAppend(${Source_Dir}/CMakeLists.txt "install(TARGETS ${Plugin_Name} DESTINATION lib/\${Target_Tuple})\n")
	#dk_fileAppend(${Source_Dir}/CMakeLists.txt "file(GLOB HEADER_FILES ${Source_Dir}/*.h)\n")
	#dk_fileAppend(${Source_Dir}/CMakeLists.txt "install(FILES \${HEADER_FILES} DESTINATION include/${Plugin_Name})\n")
	#dk_fileAppend(${Source_Dir}/CMakeLists.txt "if(NOT DKAPP)\n")
	#dk_fileAppend(${Source_Dir}/CMakeLists.txt "     set_property(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR} PROPERTY VS_STARTUP_PROJECT ${Plugin_Name})\n")
	#dk_fileAppend(${Source_Dir}/CMakeLists.txt "endif()\n")
	# add headers to DKPlugins.h
	#if(${Plugin_Name} STREQUAL DK OR STATIC)
	#if(${Plugin_Name} STREQUAL DK OR BUILD_STATIC_LIBS)
		file(GLOB HEADER_FILES RELATIVE ${DKCPP_PLUGINS_DIR} ${Source_Dir}/*.h)
		foreach(header ${HEADER_FILES})
			if(NOT PLUGINS_FILE MATCHES "${header}")
				dk_info("Adding ${header} to header file.")
				dk_set(PLUGINS_FILE ${PLUGINS_FILE} "#include \"${header}\"\\n")
			endif()
			#if(NOT PLUGINS_FILE MATCHES "DKHAVE_${Plugin_Name}")
			#	dk_info("Adding #define DKHAVE_${Plugin_Name} 1 to header file.")
			#	dk_set(PLUGINS_FILE ${PLUGINS_FILE} "#define DKHAVE_${Plugin_Name} 1\\n")
			#endif()
		endforeach()
	#endif()
	dk_enable				(${Plugin_Name})
	if(MSVC)
		dk_if(Windows		"dk_libDebug(${Source_Dir}/${Target_Tuple}/${Debug_Dir}/${Plugin_Name}.lib)")
		dk_if(Windows		"dk_libRelease(${Source_Dir}/${Target_Tuple}/${Release_Dir}/${Plugin_Name}.lib)")
	else()
		dk_if(Windows		"dk_libDebug(${Source_Dir}/${Target_Tuple}/${Debug_Dir}/lib${Plugin_Name}.a)")
		dk_if(Windows		"dk_libRelease(${Source_Dir}/${Target_Tuple}/${Release_Dir}/lib${Plugin_Name}.a)")
	endif()
	dk_if(Mac				"dk_libDebug(${Source_Dir}/${Target_Tuple}/${Debug_Dir}/lib${Plugin_Name}.a)")
	dk_if(Mac				"dk_libRelease(${Source_Dir}/${Target_Tuple}/${Release_Dir}/lib${Plugin_Name}.a)")
	dk_if(Ios				"dk_libDebug(${Source_Dir}/${Target_Tuple}/Debug-iphoneos/lib${Plugin_Name}.a)")
	dk_if(Ios				"dk_libRelease(${Source_Dir}/${Target_Tuple}/Release-iphoneos/lib${Plugin_Name}.a)")
	dk_if(Iossim			"dk_libDebug(${Source_Dir}/${Target_Tuple}/Debug-iphonesimulator/lib${Plugin_Name}.a)")
	dk_if(Iossim			"dk_libRelease(${Source_Dir}/${Target_Tuple}/Release-iphonesimulator/lib${Plugin_Name}.a)")
	dk_if(Linux				"dk_libDebug(${Source_Dir}/${Target_Tuple}/${Debug_Dir}/lib${Plugin_Name}.a)")
	dk_if(Linux				"dk_libRelease(${Source_Dir}/${Target_Tuple}/${Release_Dir}/lib${Plugin_Name}.a)")
	dk_if(Raspberry			"dk_libDebug(${Source_Dir}/${Target_Tuple}/${Debug_Dir}/lib${Plugin_Name}.a)")
	dk_if(Raspberry			"dk_libRelease(${Source_Dir}/${Target_Tuple}/${Release_Dir}/lib${Plugin_Name}.a)")
	dk_if(Android			"dk_libDebug(${Source_Dir}/${Target_Tuple}/${Debug_Dir}/lib${Plugin_Name}.a)")
	dk_if(Android			"dk_libRelease(${Source_Dir}/${Target_Tuple}/${Release_Dir}/lib${Plugin_Name}.a)")
	dk_if(Emscripten		"dk_libDebug(${Source_Dir}/${Target_Tuple}/${Debug_Dir}/lib${Plugin_Name}.a)")
	dk_if(Emscripten		"dk_libRelease(${Source_Dir}/${Target_Tuple}/${Release_Dir}/lib${Plugin_Name}.a)")

	dk_verbose("dk_append(DKPLUGIN_LIST ${Plugin_Name})  #Add to list")
	dk_append(DKPLUGIN_LIST ${Plugin_Name})  #Add to list
endfunction()





###### DKTEST ###### DKTEST ###### DKTEST ###### DKTEST ###### DKTEST ######
function(DKTEST)
	dk_debugFunc(0)
	
	dk_generateCmake()
endfunction()