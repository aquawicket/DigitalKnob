#!/usr/bin/cmake -P
### DK.cmake ############################################################
if(NOT EXISTS "$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake")
	cmake_policy(SET CMP0009 NEW)
	file(GLOB_RECURSE DK.cmake "/DK.cmake")
	list(GET DK.cmake 0 DK.cmake)
	get_filename_component(DKCMAKE_FUNCTIONS_DIR "${DK.cmake}" DIRECTORY)
	set(ENV{DKCMAKE_FUNCTIONS_DIR_} "${DKCMAKE_FUNCTIONS_DIR}/")
endif()
include("$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake")
include_guard()
#########################################################################


#########################################################################
# dk_generateAppCmake()
#
function(dk_generateAppCmake)
	dk_debugFunc()

	dk_assertPath(Target_App_Dir)
	dk_assertVar(Target_Tuple)
	dk_validate(DKCPP_PLUGINS_DIR "dk_DKBRANCH_DIR()")
	
	dk_fileWrite(${Target_App_Dir}/CMakeLists.txt   	"\#!/usr/bin/cmake -P \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\### This file is generated by DKCMake. Any Changes here, will be overwritten. ### \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\### DK.cmake ############################################################ \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt   	"cmake_minimum_required(VERSION 3.10) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"if(NOT EXISTS \"\$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    cmake_policy(SET CMP0009 NEW) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    file(GLOB_RECURSE DK.cmake \"/DK.cmake\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    list(GET DK.cmake 0 DK.cmake) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    get_filename_component(DKCMAKE_FUNCTIONS_DIR \"\${DK.cmake}\" DIRECTORY) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    set(ENV{DKCMAKE_FUNCTIONS_DIR_} \"\${DKCMAKE_FUNCTIONS_DIR}/\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"endif() \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"include(\"$ENV{DKCMAKE_FUNCTIONS_DIR_}DK.cmake\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"include_guard() \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\######################################################################### \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"dk_load(\"\$ENV{DKCMAKE_DIR}/DKVariables.cmake\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"dk_load(\"\$ENV{DKCMAKE_DIR}/DKBuildFlags.cmake\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"### ${Target_App} ### \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"project(${Target_App}) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"include_directories(${Target_App_Dir}) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"include_directories(${DKCPP_PLUGINS_DIR}) \n")
	foreach(each_include ${DKINCLUDES_LIST})
		dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  "include_directories(${each_include})\n")
	endforeach()
	foreach(each_define ${dkdefines_list})
		dk_fileAppend(${Target_App_Dir}/CMakeLists.txt	"add_definitions(-D${each_define})\n")
	endforeach()
	foreach(each_linkdir ${DKLINKDIRS_LIST})
		dk_fileAppend(${Target_App_Dir}/CMakeLists.txt 	"link_directories(${each_linkdir})\n")
	endforeach()
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"file(GLOB App_SRC \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    ${Target_App_Dir}/*.h \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    ${Target_App_Dir}/*.hpp \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    ${Target_App_Dir}/*.c \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    ${Target_App_Dir}/*.cpp \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    ${Target_App_Dir}/*.manifest \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    ${Target_App_Dir}/*.rc \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"if(Windows) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    file(GLOB Icon_SRC \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        ${Target_App_Dir}/Windows/*.h \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        ${Target_App_Dir}/Windows/*.hpp \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        ${Target_App_Dir}/Windows/*.c \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        ${Target_App_Dir}/Windows/*.cpp \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        ${Target_App_Dir}/Windows/*.manifest \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        ${Target_App_Dir}/Windows/*.rc \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    ) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    list(APPEND App_SRC \${Icon_SRC}) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"endif() \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"if(EXISTS \"${Target_App_Dir}/icon.ico\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    if(Windows) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        list(APPEND App_SRC  \"${DKCPP_PLUGINS_DIR}/_DKIMPORT/Windows/icon.h\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        list(APPEND App_SRC  \"${DKCPP_PLUGINS_DIR}/_DKIMPORT/Windows/icon.rc\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    endif() \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"endif() \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"if(HAVE_DK) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    if(Windows) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        list(APPEND App_SRC  \"${DKCPP_PLUGINS_DIR}/_DKIMPORT/Windows/assets.h\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        list(APPEND App_SRC  \"${DKCPP_PLUGINS_DIR}/_DKIMPORT/Windows/assets.rc\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    endif() \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"endif() \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"list(FILTER App_SRC EXCLUDE REGEX \"${Target_App_Dir}/assets/*\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"list(FILTER App_SRC EXCLUDE REGEX \"${Target_App_Dir}/${Target_Tuple}/*\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"dk_load(dk_Target_Tuple) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"dk_validate(Target_Tuple \"dk_Target_Tuple()\") \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"if(MSVC) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    add_executable(${Target_App} WIN32 \${App_SRC}) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"else() \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    add_executable(${Target_App} \${App_SRC}) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"endif() \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"\n")
#	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"if(MULTI_CONFIG) \n")
	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt 		"    target_link_libraries(${Target_App} ${DEBUG_LIBS} ${RELEASE_LIBS} ${LIBS}) \n")
#	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"else() \n")
#	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    if(Debug) \n")
#	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        target_link_libraries(${Target_App} ${DEBUG_LIBS} ${LIBS}) \n")
#	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    elseif(Release) \n")
#	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"        target_link_libraries(${Target_App} ${RELEASE_LIBS} ${LIBS}) \n")
#	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"    endif() \n")
#	dk_fileAppend(${Target_App_Dir}/CMakeLists.txt  	"endif() \n")
endfunction()





